// #4 live — Message != 3
fetch logs, from:now()-15m
| fieldsAdd host = coalesce(k8s.pod.name, host.name)
| filter contains(lower(host), "alfrescoaca", caseSensitive:false)
    or contains(log.source, "alfrescoaca", caseSensitive:false)
| filter not contains(lower(host), "alfrescoacr-batch", caseSensitive:false)
| summarize by:{ host }
| summarize Message = count()
| filter Message != 3
| fieldsAdd host = "Total"
| fields host, Message

// #4 host list
fetch logs, from:now()-15m
| fieldsAdd host = coalesce(k8s.pod.name, host.name)
| filter contains(lower(host), "alfrescoaca", caseSensitive:false)
    or contains(log.source, "alfrescoaca", caseSensitive:false)
| filter not contains(lower(host), "alfrescoacr-batch", caseSensitive:false)
| summarize events = count(), by:{ host }
| sort host asc
| fields host, events

// #5 template — set Message != N
fetch logs, from:now()-15m
| fieldsAdd host = coalesce(k8s.pod.name, host.name)
| filter contains(lower(host), "alfrescocollabsrv", caseSensitive:false)
    or contains(log.source, "alfrescocollabsrv", caseSensitive:false)
| summarize by:{ host }
| summarize Message = count()
| filter Message != 1
| fieldsAdd host = "Total"
| fields host, Message
