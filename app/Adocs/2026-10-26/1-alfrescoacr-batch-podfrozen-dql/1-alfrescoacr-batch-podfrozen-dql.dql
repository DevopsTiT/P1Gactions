// #1 live — Prod_PnC_Alfrescoacr_BatchPODFrozen_High
fetch logs, from:now()-15m
| fieldsAdd host = coalesce(k8s.pod.name, host.name)
| filter contains(lower(host), "alfrescoacr-batch", caseSensitive:false)
    or contains(log.source, "alfrescoacr-batch", caseSensitive:false)
| summarize by:{ host }
| summarize Message = count()
| filter Message != 4
| fieldsAdd host = "Total"
| fields host, Message

// #1 host list
fetch logs, from:now()-15m
| fieldsAdd host = coalesce(k8s.pod.name, host.name)
| filter contains(lower(host), "alfrescoacr-batch", caseSensitive:false)
    or contains(log.source, "alfrescoacr-batch", caseSensitive:false)
| summarize events = count(), by:{ host }
| sort host asc
| fields host, events

// #1 verify — 3 hosts → alert
data record(host: "alfrescoacr-batch-inssuite-prod-0"),
     record(host: "alfrescoacr-batch-inssuite-prod-1"),
     record(host: "alfrescoacr-batch-inssuite-prod-2")
| summarize by:{ host }
| summarize Message = count()
| filter Message != 4
| fieldsAdd host = "Total"
| fields host, Message

// #3 sketch — Agrex (change != 4 if needed)
fetch logs, from:now()-15m
| fieldsAdd host = coalesce(k8s.pod.name, host.name)
| filter contains(lower(host), "agrex", caseSensitive:false)
    or contains(log.source, "agrex", caseSensitive:false)
| summarize by:{ host }
| summarize Message = count()
| filter Message != 4
| fieldsAdd host = "Total"
| fields host, Message
