// One DQL per host group — SHOW PII-like lines (name / address), not counts
// Run ONE block at a time in Logs → Advanced
// Shared PII pattern (name + address). Always limit 20.
// If matchesValue returns empty: check ALJ vs ALI / spelling via contains(dt.host_group.id, "FRAGMENT")

// ========== SHARED PII REGEX (copy into each query) ==========
// (?i)(AddressKana|AddressKanji|AXACleansingAddress|AXACleansingPersonName|address\s*,\s*Value\s*=|person_fullname|Type\s*=\s*address|insuredPerson|holderName|displayName|kanjiFullAddress|kanaFullAddress|given_name|family_name|loginId|subscriberAddr|PERSON_ADDRESS|OFFICE_ADDRESS|policyHolderName)

// ----- 01 MDM APP -----
fetch logs, from: now()-24h
| filter matchesValue(dt.host_group.id, "C_ALI_BU_DATAENGI_A_CUSTMDMGM_E_PRD_T_APP")
| filter matchesRegex(content, "(?i)(AddressKana|AddressKanji|AXACleansingAddress|AXACleansingPersonName|address\\s*,\\s*Value\\s*=|person_fullname|Type\\s*=\\s*address|insuredPerson|holderName|displayName|kanjiFullAddress|given_name|family_name|loginId|subscriberAddr|PERSON_ADDRESS|OFFICE_ADDRESS)")
| fields timestamp, dt.host_group.id, host.name, content
| limit 20

// ----- 01b MDM APP (Excel ALJ / DATAENGLF variant — use if 01 empty) -----
fetch logs, from: now()-24h
| filter matchesValue(dt.host_group.id, "C_ALJ_BU_DATAENGLF_A_CUSTMDMGM_E_PRD_T_APP")
| filter matchesRegex(content, "(?i)(AddressKana|AddressKanji|AXACleansingAddress|AXACleansingPersonName|address\\s*,\\s*Value\\s*=|person_fullname|Type\\s*=\\s*address|insuredPerson|holderName|displayName|kanjiFullAddress|given_name|family_name|loginId|subscriberAddr|PERSON_ADDRESS|OFFICE_ADDRESS)")
| fields timestamp, dt.host_group.id, host.name, content
| limit 20

