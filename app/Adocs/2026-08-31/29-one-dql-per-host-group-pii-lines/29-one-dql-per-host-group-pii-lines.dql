// One DQL per host group — SHOW PII-like lines (name / address), 24h
// Run ONE block at a time. No summarize.
// Uses contains / simple regex (NO \\s escapes — those break paste into Dynatrace)
// If exact ID empty: try 01b or fragment blocks at bottom

// ========== PII LINE FILTER (shared idea) ==========
// contains AXACleansingAddress OR AXACleansingPersonName OR AddressKana
// OR address, Value = OR person_fullname OR Type = address
// OR holderName / given_name / family_name / displayName / insuredPerson

// ----- 01 MDM APP (live ID that returned 36k cleansing hits before) -----
fetch logs, from: now()-24h
| filter matchesValue(dt.host_group.id, "C_ALI_BU_DATAENGI_A_CUSTMDMGM_E_PRD_T_APP")
| filter matchesRegex(content, "(?i)(AddressKana|AddressKanji|AXACleansingAddress|AXACleansingPersonName|address, Value =|person_fullname|Type = address|insuredPerson|holderName|displayName|kanjiFullAddress|given_name|family_name|loginId|subscriberAddr|PERSON_ADDRESS|OFFICE_ADDRESS)")
| fields timestamp, dt.host_group.id, host.name, content
| limit 20

// ----- 01b MDM Excel variant -----
fetch logs, from: now()-24h
| filter matchesValue(dt.host_group.id, "C_ALJ_BU_DATAENGLF_A_CUSTMDMGM_E_PRD_T_APP")
| filter matchesRegex(content, "(?i)(AddressKana|AddressKanji|AXACleansingAddress|AXACleansingPersonName|address, Value =|person_fullname|Type = address|insuredPerson|holderName|displayName|kanjiFullAddress|given_name|family_name|loginId|subscriberAddr|PERSON_ADDRESS|OFFICE_ADDRESS)")
| fields timestamp, dt.host_group.id, host.name, content
| limit 20

// ----- 01c MDM by fragment (safest if ID spelling unsure) -----
fetch logs, from: now()-24h
| filter contains(dt.host_group.id, "CUSTMDMGM")
| filter matchesRegex(content, "(?i)(AddressKana|AddressKanji|AXACleansingAddress|AXACleansingPersonName|address, Value =|person_fullname|Type = address|insuredPerson|holderName|displayName|kanjiFullAddress|given_name|family_name|loginId|PERSON_ADDRESS|OFFICE_ADDRESS)")
| fields timestamp, dt.host_group.id, host.name, content
| limit 20

// ----- 01d MDM simple contains (no regex — use if matchesRegex still fails) -----
fetch logs, from: now()-24h
| filter contains(dt.host_group.id, "CUSTMDMGM")
| filter (
    contains(content, "AXACleansingAddress")
    or contains(content, "AXACleansingPersonName")
    or contains(content, "AddressKana")
    or contains(content, "address, Value =")
    or contains(content, "person_fullname")
    or contains(content, "Type = address")
  )
| fields timestamp, dt.host_group.id, host.name, content
| limit 20

