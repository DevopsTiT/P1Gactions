# Dynatrace DQL — Japanese text first, then JP PII keywords
# Notebooks / Dashboards (new) / Logs query
# Review before run; do not auto-run against prod without approval

# --- A) Sample lines: JP chars + PII keyword ---
fetch logs
| filter matchesPhrase(content, "") == false
| filter content != ""
| filter matchesValue(content, ".*[\\u3000-\\u30FF\\u4E00-\\u9FFF].*")
| filter matchesValue(content, ".*(氏名|住所|電話|生年月日|郵便番号|メール|メールアドレス|携帯|携帯電話|携帯番号|固定電話|電話番号|ファックス|生年月|誕生日|生年|生月|生日|年齢|性別|身分証|身分証明書|マイナンバー|個人番号|運転免許|免許証|パスポート|旅券|銀行口座|口座番号|銀行コード|支店コード|クレジットカード|カード番号|カード|会社).*")
| sort timestamp desc
| fields timestamp, content, host.name, dt.source_entity, loglevel
| limit 200

# --- B) Count by host (after JP + keyword filters) ---
fetch logs
| filter matchesValue(content, ".*[\\u3000-\\u30FF\\u4E00-\\u9FFF].*")
| filter matchesValue(content, ".*(氏名|住所|電話|生年月日|郵便番号|メール|メールアドレス|携帯|携帯電話|携帯番号|固定電話|電話番号|ファックス|生年月|誕生日|生年|生月|生日|年齢|性別|身分証|身分証明書|マイナンバー|個人番号|運転免許|免許証|パスポート|旅券|銀行口座|口座番号|銀行コード|支店コード|クレジットカード|カード番号|カード|会社).*")
| summarize pii_hits = count(), by: { host.name }
| sort pii_hits desc
| limit 50

# --- C) Keyword hit flags (which labels appeared) ---
fetch logs
| filter matchesValue(content, ".*[\\u3000-\\u30FF\\u4E00-\\u9FFF].*")
| filter matchesValue(content, ".*(氏名|住所|電話|生年月日|郵便番号|メール|メールアドレス|携帯|携帯電話|携帯番号|固定電話|電話番号|ファックス|生年月|誕生日|生年|生月|生日|年齢|性別|身分証|身分証明書|マイナンバー|個人番号|運転免許|免許証|パスポート|旅券|銀行口座|口座番号|銀行コード|支店コード|クレジットカード|カード番号|カード|会社).*")
| fieldsAdd
    hit_shimei = if(contains(content, "氏名"), 1, 0),
    hit_jusho = if(contains(content, "住所"), 1, 0),
    hit_denwa = if(contains(content, "電話"), 1, 0),
    hit_seinengappi = if(contains(content, "生年月日"), 1, 0),
    hit_yubin = if(contains(content, "郵便番号"), 1, 0),
    hit_mail = if(contains(content, "メール"), 1, 0),
    hit_mynumber = if(contains(content, "マイナンバー") or contains(content, "個人番号"), 1, 0),
    hit_koza = if(contains(content, "口座番号") or contains(content, "銀行口座"), 1, 0),
    hit_card = if(contains(content, "クレジットカード") or contains(content, "カード番号"), 1, 0)
| summarize
    lines = count(),
    shimei = sum(hit_shimei),
    jusho = sum(hit_jusho),
    denwa = sum(hit_denwa),
    seinengappi = sum(hit_seinengappi),
    yubin = sum(hit_yubin),
    mail = sum(hit_mail),
    mynumber = sum(hit_mynumber),
    koza = sum(hit_koza),
    card = sum(hit_card),
    by: { host.name }
| sort lines desc
| limit 50
