// 1. Alert 1 query (asa_networksyslog), last 30 days
fetch logs, from:now()-30d
| filter contains(log.source, "networksyslog") or contains(log.source, "/var/log/ASA/")
| filter contains(content, "Windows_LDAP as FAILED")

// 2. Alert 2 query (windows basic), last 30 days
fetch logs, from:now()-30d
| filter contains(log.source, "/var/log/ASA/") or matchesValue(host.name, "ljcmgt14*")
| filter contains(content, "Windows_LDAP as FAILED")

// 3. Where do FAILED lines come from? If only one log.source shows up, both alerts catch the same lines
fetch logs, from:now()-30d
| filter contains(content, "Windows_LDAP as FAILED")
| summarize count(), by:{log.source, host.name, dt.system.bucket}
