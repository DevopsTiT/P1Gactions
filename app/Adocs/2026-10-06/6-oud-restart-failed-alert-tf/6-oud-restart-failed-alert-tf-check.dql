// 1. Which log sources does the OUD host send? (Splunk showed 2 sources and 2 sourcetypes)
fetch logs, from:now()-24h
| filter matchesValue(host.name, "WPALJA2162*")
| summarize count(), by:{log.source, host.name}

// 2. Detector query over 30 days: past "failed" lines
fetch logs, from:now()-30d
| filter matchesValue(host.name, "WPALJA2162*") and contains(log.source, "/opt/oracle/oud/")
| filter contains(content, "failed", caseSensitive:false)
| fields timestamp, log.source, content
| sort timestamp desc

// 3. Noise check: how many "failed" lines per log.source (narrow the source if one file is noisy)
fetch logs, from:now()-7d
| filter matchesValue(host.name, "WPALJA2162*")
| filter contains(content, "failed", caseSensitive:false)
| summarize count(), by:{log.source}
