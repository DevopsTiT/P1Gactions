// 1. Exactly what the detector runs (it uses the last 2 hours by default)
fetch logs
| filter contains(log.source, "/var/log/ASA/") or matchesValue(host.name, "ljcmgt14*")
| filter contains(content, "Windows_LDAP as FAILED")

// 2. Same query over 30 days: should show the Sep 23 and Sep 24 lines
fetch logs, from:now()-30d
| filter contains(log.source, "/var/log/ASA/") or matchesValue(host.name, "ljcmgt14*")
| filter contains(content, "Windows_LDAP as FAILED")
| fields timestamp, host.name, log.source, content
