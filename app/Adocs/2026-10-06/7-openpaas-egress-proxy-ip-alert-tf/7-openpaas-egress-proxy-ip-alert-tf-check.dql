// 1. Confirm how the API gateway syslog arrives (Splunk: host EEAA2015, source /SYSLOG/APIGW/prod/local4.log)
fetch logs, from:now()-1h
| filter contains(log.source, "APIGW") or matchesValue(host.name, "EEAA2015*")
| summarize count(), by:{log.source, host.name}

// 2. Detector query: should return NO rows while the egress IPs are in use
fetch logs, from:now()-15m
| filter contains(log.source, "/SYSLOG/APIGW/prod/")
| filter contains(content, "/maam/")
| filter contains(content, "52.76.125.86") or contains(content, "54.179.120.88")
| summarize count = count()
| filter count == 0
| fieldsAdd check = "egress_proxy_public_ip"

// 3. Lines per IP every 15 minutes over 24 hours (to see normal volume and gaps)
fetch logs, from:now()-24h
| filter contains(log.source, "/SYSLOG/APIGW/prod/")
| filter contains(content, "/maam/")
| fieldsAdd ip = if(contains(content, "52.76.125.86"), "52.76.125.86", else: if(contains(content, "54.179.120.88"), "54.179.120.88", else: "other"))
| summarize count(), by:{bin(timestamp, 15m), ip}
