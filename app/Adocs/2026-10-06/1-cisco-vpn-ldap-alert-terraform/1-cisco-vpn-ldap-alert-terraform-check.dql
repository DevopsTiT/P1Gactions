// Query 1: how do the ASA syslog lines arrive in Dynatrace? (find log.source, host, bucket)
fetch logs, from:now()-30d
| filter contains(content, "Windows_LDAP as FAILED")
| summarize lines = count(), by:{log.source, host.name, dt.system.bucket}
| sort lines desc

// Query 2: the raw lines (should match the 2 Splunk events on Sep 23 and Sep 24)
fetch logs, from:now()-30d
| filter contains(content, "%ASA-2-113022")
| filter contains(content, "Windows_LDAP as FAILED")
| fieldsAdd time_jst = formatTimestamp(timestamp, format:"yyyy-MM-dd HH:mm:ss", timezone:"Asia/Tokyo")
| fields time_jst, host.name, log.source, content
| sort time_jst desc

// Query 3: which LDAP server failed, and how many lines per minute at most?
fetch logs, from:now()-30d
| filter contains(content, "Windows_LDAP as FAILED")
| parse content, "LD 'LDAP server ' IPADDR:ldap_server"
| fieldsAdd minute = bin(timestamp, 1m)
| summarize per_minute = count(), by:{minute, ldap_server}
| sort per_minute desc
| limit 20

// Query 4: the detector series (preview what the detector sees)
fetch logs, from:now()-30d
| filter contains(log.source, "/var/log/ASA/") or matchesValue(host.name, "ljcmgt14*")
| filter contains(content, "%ASA-2-113022")
| filter contains(content, "Windows_LDAP as FAILED")
| makeTimeseries count = count(default: 0), interval:1m
