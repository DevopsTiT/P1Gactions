// 0. See the real tag text first (tags is not returned unless you add it)
fetch dt.entity.host
| fieldsAdd tags
| expand tags
| filter contains(tags, "env", caseSensitive:false)
| summarize hosts = count(), by:{ tags }
| sort hosts desc

// J. Entities with environment tags, across types (tags added in every fetch)
fetch dt.entity.host
| fieldsAdd tags
| append [ fetch dt.entity.service | fieldsAdd tags ]
| append [ fetch dt.entity.process_group_instance | fieldsAdd tags ]
| append [ fetch dt.entity.aws_lambda_function | fieldsAdd tags ]
| expand tags
| filter in(lower(tags), {
    "[aws]adj:env:openshift:preprod",
    "[aws]global:env:preprod",
    "[aws]adj:env:preprod",
    "env:dev",
    "env:preprod"
  })
| fields id, entity.name, tags

// K. Hosts with one tag (tags is a list, so test membership, and use entity.name)
fetch dt.entity.host
| fieldsAdd tags
| filter in("[AWS]global:env:Preprod", tags)
| fields name = entity.name, tags

// I. Windows host CPU (from part 3): use the OS field, not a tag
timeseries cpu_usage = avg(dt.host.cpu.usage), by:{ dt.entity.host }
| fieldsAdd host.name = entityName(dt.entity.host), os = entityAttr(dt.entity.host, "osType")
| filter os == "WINDOWS"
| fieldsAdd average_usage = arrayAvg(cpu_usage)
| sort average_usage desc

// L. Infrastructure Monitoring host-hours billed per day
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Infrastructure Monitoring"
| dedup event.id
| makeTimeseries total_billed_usage = sum(billed_host_hours), interval:24h, time:usage.start

// L2. Same per day as numbers, plus "average hosts running" (host-hours / 24)
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Infrastructure Monitoring"
| dedup event.id
| summarize host_hours = sum(billed_host_hours), by:{ day = bin(usage.start, 1d) }
| fieldsAdd avg_hosts = host_hours / 24
| sort day asc

// M. Host-hours per host, no 1,000-row cut
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Infrastructure Monitoring"
| dedup event.id
| summarize billed_hours = sum(billed_host_hours), by:{ dt.entity.host }
| fields host_id = dt.entity.host, host_name = entityName(dt.entity.host), billed_hours
| sort billed_hours desc
| limit 10000

// M2. Hosts that were NOT on all the time (part-time, autoscaled, added or removed)
fetch dt.system.events, from:now()-30d
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Infrastructure Monitoring"
| dedup event.id
| summarize billed_hours = sum(billed_host_hours), by:{ dt.entity.host }
| filter billed_hours < 720
| fields host_name = entityName(dt.entity.host), billed_hours
| sort billed_hours asc

// N. Number of billed hosts (the cut-off cell, likely shape)
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Infrastructure Monitoring"
| dedup event.id
| summarize billed_hosts = countDistinct(dt.entity.host)
