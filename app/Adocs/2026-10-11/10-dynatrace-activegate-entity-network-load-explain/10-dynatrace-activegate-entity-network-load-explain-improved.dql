// V0. Does the ActiveGate table have anything at all? (no filter)
fetch dt.entity.apm_security_gateway
| limit 20

// V1. ActiveGates with name and tags, before any filter
fetch dt.entity.apm_security_gateway
| fieldsAdd tags
| fields id, entity.name, tags
| sort entity.name asc

// V2. "eastasia" anywhere in the name or tags, ignoring case
fetch dt.entity.apm_security_gateway
| fieldsAdd tags
| filter contains(entity.name, "eastasia", caseSensitive:false)
      or contains(toString(tags), "eastasia", caseSensitive:false)
| fields id, entity.name, tags

// W. Logs with a time range and only useful columns, instead of a bare fetch logs
fetch logs, from:now()-1h
| fields timestamp, status, host.name, log.source, content
| sort timestamp desc
| limit 100

// X1. Same process chart, with the real name and hourly points
timeseries load = avg(dt.process.network.load),
  by:{ dt.entity.process_group_instance },
  filter:{ dt.entity.process_group_instance == "PROCESS_GROUP_INSTANCE-38F231AB4892E434" },
  interval:1h
| fieldsAdd process = entityName(dt.entity.process_group_instance)

// X2. When was the peak, and how big compared with normal
timeseries load = avg(dt.process.network.load),
  by:{ dt.entity.process_group_instance },
  filter:{ dt.entity.process_group_instance == "PROCESS_GROUP_INSTANCE-38F231AB4892E434" },
  interval:1h
| fieldsAdd peak = arrayMax(load), normal = arrayAvg(load)
| fieldsAdd peak_vs_normal = peak / normal

// X3. What the metric means (unit and description)
metrics
| filter metric.key == "dt.process.network.load"
