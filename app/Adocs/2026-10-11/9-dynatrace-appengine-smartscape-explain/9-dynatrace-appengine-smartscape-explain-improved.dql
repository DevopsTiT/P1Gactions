// A0. Which billing event types exist at all (run before any AppEngine query)
fetch dt.system.events, from:now()-30d
| filter event.kind == "BILLING_USAGE_EVENT"
| summarize records = count(), by:{ event.type }
| sort records desc

// A1. Daily AppEngine invocations by function type (clearer version, with a scan limit kept)
fetch dt.system.events, from:now()-30d
| filter event.kind == "BILLING_USAGE_EVENT" and startsWith(event.type, "AppEngine Functions")
| filter billing_type == "BILLABLE" or isNull(billing_type)
| dedup event.id
| fieldsAdd kind = if(matchesPhrase(function.type, "AD_HOC"), "Ad hoc functions",
                   else: if(matchesPhrase(function.type, "ACTION"), "Custom actions",
                   else: if(matchesPhrase(function.type, "STANDARD"), "App functions",
                   else: "Other")))
| summarize invocations = sum(coalesce(billed_invocations, 1)), by:{ day = bin(timestamp, 1d), kind }
| sort day desc, invocations desc

// A2. Who and which app call functions the most
fetch dt.system.events, from:now()-30d
| filter event.kind == "BILLING_USAGE_EVENT" and startsWith(event.type, "AppEngine Functions")
| filter billing_type == "BILLABLE" or isNull(billing_type)
| dedup event.id
| summarize invocations = sum(coalesce(billed_invocations, 1)), by:{ User = user.email, Calling_App = caller.app.id }
| sort invocations desc

// T1. What node types exist, and does any look like an ActiveGate
smartscapeNodes "*"
| summarize nodes = count(), by:{ type }
| sort nodes desc

// T2. Look at one node of a type to learn its field names before using fields
smartscapeNodes "HOST"
| limit 1

// U1. Per-host ratios from the node counts (disks, NICs, processes per host)
smartscapeNodes "*"
| summarize nodes = count(), by:{ type }
| summarize hosts = sum(if(type == "HOST", nodes, else:0)),
            disks = sum(if(type == "DISK", nodes, else:0)),
            nics = sum(if(type == "NETWORK_INTERFACE", nodes, else:0)),
            processes = sum(if(type == "PROCESS", nodes, else:0)),
            agents = sum(if(type == "ONEAGENT", nodes, else:0))
| fieldsAdd disks_per_host = disks / hosts, nics_per_host = nics / hosts,
            processes_per_host = processes / hosts, hosts_without_agent = hosts - agents
