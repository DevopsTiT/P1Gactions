// Q1. Control-M agent health per host: which hosts run which agent processes
fetch dt.entity.process_group_instance
| filter in(entity.name, { "p_ctmag", "p_ctmat", "p_ctmar", "ctm-ag-uploader.jar" })
| expand host_id = belongs_to[dt.entity.host]
| summarize processes = collectDistinct(entity.name), by:{ host_id }
| fieldsAdd host.name = entityName(host_id, type:"dt.entity.host"),
            has_listener = in("p_ctmag", processes),
            has_tracker  = in("p_ctmat", processes),
            has_uploader = in("ctm-ag-uploader.jar", processes)
| fields host.name, has_listener, has_tracker, has_uploader, processes
| sort host.name asc

// Q2. Hosts where an agent part is missing (the useful alert-style view)
fetch dt.entity.process_group_instance
| filter in(entity.name, { "p_ctmag", "p_ctmat" })
| expand host_id = belongs_to[dt.entity.host]
| summarize processes = collectDistinct(entity.name), by:{ host_id }
| filter arraySize(processes) < 2
| fields host.name = entityName(host_id, type:"dt.entity.host"), processes

// Q3. Same CoPilot list, without duplicate columns
fetch dt.entity.process_group_instance
| filter in(entity.name, { "p_ctmat", "p_ctmag" })
| expand host_id = belongs_to[dt.entity.host]
| fields process_name = entity.name, host_name = entityName(host_id, type:"dt.entity.host"), id
| sort host_name asc, process_name asc

// Q4. Availability % of the agent processes over the last 24 hours (simple version of the app's math)
timeseries avail = avg(dt.process.availability), by:{ dt.entity.process_group_instance }, from:now()-24h
| fieldsAdd process = entityName(dt.entity.process_group_instance)
| filter in(process, { "p_ctmag", "p_ctmat", "ctm-ag-uploader.jar" })
| fieldsAdd avg_availability = arrayAvg(avail)
| sort avg_availability asc

// Q5. Billed usage for product EIP, per capability (no prices, just the amounts)
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT"
| dedup event.id
| fieldsAdd alloc = dt.cost.product
| expand alloc
| filter coalesce(alloc[key], alloc) == "EIP"
| fieldsAdd usage = coalesce(billed_host_hours,
                             billed_gibibyte_hours,
                             toDouble(coalesce(alloc[billed_bytes], billed_bytes)) / (1024 * 1024 * 1024),
                             billed_invocations)
| summarize usage = sum(usage), by:{ event.type }
| sort usage desc
