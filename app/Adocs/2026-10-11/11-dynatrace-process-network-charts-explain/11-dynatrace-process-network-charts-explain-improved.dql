// Z1. Incoming traffic of one process, in bits per second with an honest label
timeseries rx = avg(dt.process.network.bytes_rx),
  by:{ dt.entity.process_group_instance },
  filter:{ dt.entity.process_group_instance == "PROCESS_GROUP_INSTANCE-38F231AB4892E434" }
| fieldsAdd rx_bits = rx[] * 8
| fieldsAdd metricName = "Bits received per second"

// Z2. Incoming and outgoing traffic side by side for the same process
timeseries { rx = avg(dt.process.network.bytes_rx), tx = avg(dt.process.network.bytes_tx) },
  by:{ dt.entity.process_group_instance },
  filter:{ dt.entity.process_group_instance == "PROCESS_GROUP_INSTANCE-38F231AB4892E434" }
| fieldsAdd process = entityName(dt.entity.process_group_instance)

// AA1. All instances of one process group, with readable names and host
timeseries rx = avg(dt.process.network.bytes_rx),
  by:{ dt.entity.process_group_instance },
  filter:{ dt.entity.process_group == "PROCESS_GROUP-A73B79EBAEDBF111" }
| fieldsAdd instance = entityName(dt.entity.process_group_instance)

// BB1. Fix for the 0-record cell: an instance ID belongs on the instance field
timeseries load = avg(dt.process.network.load),
  by:{ dt.entity.process_group_instance },
  filter:{ dt.entity.process_group_instance == "PROCESS_GROUP_INSTANCE-B2059778413E0B79" }

// BB2. Or find the group that instance belongs to, then chart the whole group
fetch dt.entity.process_group_instance
| filter id == "PROCESS_GROUP_INSTANCE-B2059778413E0B79"
| fields id, entity.name, group_id = instance_of[dt.entity.process_group]

// CC1. How bursty a process is: busy minutes vs idle minutes
timeseries load = avg(dt.process.network.load),
  by:{ dt.entity.process_group_instance },
  filter:{ dt.entity.process_group_instance == "PROCESS_GROUP_INSTANCE-3A9B81C22D673E16" },
  interval:1m
| fieldsAdd busy_minutes = arraySize(arrayRemoveNulls(iCollectArray(if(load[] > 0, 1)))),
            peak = arrayMax(load), avg_load = arrayAvg(load)
