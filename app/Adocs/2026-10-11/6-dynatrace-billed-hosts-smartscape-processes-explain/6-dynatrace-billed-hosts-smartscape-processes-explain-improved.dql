// N. Billed hosts over time, interval that fits the limit (1 hour over a month)
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Infrastructure Monitoring"
| dedup event.id
| filter isNotNull(billed_host_hours) and billed_host_hours > 0
| makeTimeseries host_count = countDistinct(dt.entity.host), interval:1h, time:usage.start

// N2. One number: peak and average billed hosts per hour
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Infrastructure Monitoring"
| dedup event.id
| filter billed_host_hours > 0
| summarize hosts = countDistinct(dt.entity.host), by:{ hour = bin(usage.start, 1h) }
| summarize peak_hosts = max(hosts), avg_hosts = avg(hosts), min_hosts = min(hosts)

// O. Fix for "summarize needs an aggregation": add count()
smartscapeNodes "AWS*"
| summarize nodes = count(), by:{ aws.account.id }
| sort nodes desc

// O2. AWS nodes per account and per type
smartscapeNodes "AWS*"
| summarize nodes = count(), by:{ aws.account.id, type }
| sort aws.account.id asc, nodes desc

// P1. The Control-M uploader processes, with host and process group (simple version of the app query)
fetch dt.entity.process_group_instance
| filter entity.name == "ctm-ag-uploader.jar"
| expand host_id = belongs_to[dt.entity.host]
| fieldsAdd pg_id = instance_of[dt.entity.process_group]
| fieldsAdd host.name = entityName(host_id, type:"dt.entity.host"),
            group.name = entityName(pg_id, type:"dt.entity.process_group")
| fields id, entity.name, host.name, group.name

// P2. Open Davis events on those processes
fetch dt.davis.events, from:now()-24h
| filter event.status == "ACTIVE" and event.category != "INFO"
| expand affected_entity_ids
| filter startsWith(affected_entity_ids, "PROCESS_GROUP_INSTANCE-")
| fieldsAdd process = entityName(affected_entity_ids, type:"dt.entity.process_group_instance")
| filter process == "ctm-ag-uploader.jar"
| fields event.start, event.type, event.name, event.category, process, affected_entity_ids
| sort event.start desc

// P3. Availability and CPU of those processes over time
timeseries { avail = avg(dt.process.availability), cpu = avg(dt.process.cpu.usage) },
  by:{ dt.entity.process_group_instance }, union:true
| fieldsAdd process = entityName(dt.entity.process_group_instance)
| filter process == "ctm-ag-uploader.jar"
