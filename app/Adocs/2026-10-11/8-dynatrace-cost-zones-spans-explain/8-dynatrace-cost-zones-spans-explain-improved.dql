// C1. EIP total per capability (add this at the end of the cost query, instead of the row-by-row list)
//     ... cost query up to the fieldsRename line ...
| summarize usage = sum(usage), cost = sum(toDouble(cost)), by:{ capability, unit_price = price, currency }
| sort cost desc

// C2. EIP cost per day per capability (same place in the query)
| summarize cost = sum(toDouble(cost)), by:{ day = bin(usage.start, 1d), capability }
| sort day asc

// C3. Quick check: how many GiB of logs EIP really ingests per day
fetch dt.system.events
| filter event.kind == "BILLING_USAGE_EVENT" and event.type == "Log Management & Analytics - Ingest & Process"
| dedup event.id
| fieldsAdd alloc = dt.cost.product
| expand alloc
| filter coalesce(alloc[key], alloc) == "EIP"
| fieldsAdd gib = toDouble(coalesce(alloc[billed_bytes], billed_bytes)) / (1024 * 1024 * 1024)
| summarize gib = sum(gib), by:{ day = bin(usage.start, 1d) }
| sort day asc

// Z1. Management zones with how many hosts each (instead of one row per host-zone pair)
fetch dt.entity.host
| fieldsAdd managementZones
| expand managementZones
| summarize hosts = count(), by:{ managementZones }
| sort hosts desc

// Z2. Hosts that are in no management zone (they are invisible to zone-based permissions and alerting)
fetch dt.entity.host
| fieldsAdd managementZones
| filter isNull(managementZones) or arraySize(managementZones) == 0
| fields entity.name, id

// S1. Same endpoint chart from the request metric (faster and cheaper than fetch spans)
timeseries requests = sum(dt.service.request.count),
  by:{ endpoint.name },
  filter:{ dt.entity.service == "SERVICE-87E0B847048C5C0B" },
  interval:1h
| sort arraySum(requests) desc
| limit 10

// S2. Errors and response time for the same endpoints
timeseries { requests = sum(dt.service.request.count),
             failed = sum(dt.service.request.failure_count),
             p90_ms = percentile(dt.service.request.response_time, 90) },
  by:{ endpoint.name },
  filter:{ dt.entity.service == "SERVICE-87E0B847048C5C0B" },
  interval:1h
| fieldsAdd error_rate_pct = 100 * arraySum(failed) / arraySum(requests)
| sort arraySum(requests) desc
| limit 10

// S3. Original spans query, kept for when you need span-level detail
fetch spans
| filter isNotNull(endpoint.name)
| filter dt.entity.service == "SERVICE-87E0B847048C5C0B"
| makeTimeseries count(), by:{ endpoint.name }, time:start_time
| sort arrayAvg(`count()`) desc
| limit 10
