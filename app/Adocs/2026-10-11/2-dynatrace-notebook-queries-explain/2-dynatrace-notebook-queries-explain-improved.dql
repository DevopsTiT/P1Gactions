// 1. Process group network load, finer buckets (1 hour instead of the automatic 6 hours)
timeseries load = avg(dt.process.network.load), by:{ dt.entity.process_group }, filter:{ dt.entity.process_group == "PROCESS_GROUP-A73B79EBAEDBF111" }, interval:1h
| fieldsAdd name = entityName(dt.entity.process_group)

// 2a. Fix for the 0-record cell: the ID starts with PROCESS_GROUP-, so filter on process_group
timeseries load = avg(dt.process.network.load), by:{ dt.entity.process_group }, filter:{ dt.entity.process_group == "PROCESS_GROUP-ADEC3A526994F280" }

// 2b. If you really want one line per instance of that group
timeseries load = avg(dt.process.network.load), by:{ dt.entity.process_group_instance }, filter:{ dt.entity.process_group == "PROCESS_GROUP-ADEC3A526994F280" }
| fieldsAdd instance = entityName(dt.entity.process_group_instance)

// 2c. What the metric is (unit and description)
metrics
| filter metric.key == "dt.process.network.load"

// 3a. ERROR logs, grouped so the noise is visible
fetch logs, from:now()-2h
| filter loglevel == "ERROR"
| summarize errors = count(), by:{ log.source }
| sort errors desc

// 3b. ERROR logs without the Qualys security agent noise
fetch logs, from:now()-2h
| filter loglevel == "ERROR"
| filter not matchesPhrase(log.source, "qualys")
| fields timestamp, host.name, log.source, content
| sort timestamp desc

// 4. Hosts that run Node.js, one row per host
fetch dt.entity.process_group_instance
| filter processType == "NODE_JS"
| fieldsAdd host_id = belongs_to[dt.entity.host]
| summarize node_processes = count(), by:{ host_id }
| lookup [ fetch dt.entity.host | fields id, entity.name ], sourceField:host_id, lookupField:id, fields:{ entity.name }
| sort node_processes desc
