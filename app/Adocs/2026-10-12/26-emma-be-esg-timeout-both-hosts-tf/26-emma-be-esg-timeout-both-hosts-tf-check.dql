// 1. Gateway host and source in Dynatrace (Splunk: EEAA2015.ppprivmgmt.intraxa, /SYSLOG/APIGW/prod/local4.log)
fetch logs, from:now()-1h
| filter contains(host.name, "EEAA2015", caseSensitive:false)
| summarize lines = count(), by:{ host.name, log.source }

// 2. Backend pod names: host.name or k8s.pod.name?
fetch logs, from:now()-1h
| filter startsWith(host.name, "myaxabackend-") or startsWith(k8s.pod.name, "myaxabackend-")
| summarize lines = count(), by:{ host.name, k8s.pod.name, k8s.workload.name }

// 3. Gateway timeouts over 30 days
fetch logs, from:now()-30d
| filter contains(host.name, "EEAA2015", caseSensitive:false)
| filter contains(log.source, "/SYSLOG/APIGW/prod/local4.log", caseSensitive:false)
| filter contains(content, "Problem routing to", caseSensitive:false)
| filter contains(content, "timed out", caseSensitive:false)
| filter contains(content, "myaxa-api.alj.intraxa", caseSensitive:false)
| summarize hits = count(), sample = takeFirst(content)

// 4. Busiest 5 minute windows for both parts: was more than 20 ever reached?
fetch logs, from:now()-30d
| filter (
      (startsWith(host.name, "myaxabackend-") or startsWith(k8s.pod.name, "myaxabackend-"))
      and contains(content, "api-jp-cert.corp.intraxa", caseSensitive:false)
      and contains(content, "java.net.SocketTimeoutException", caseSensitive:false)
    ) or (
      contains(host.name, "EEAA2015", caseSensitive:false)
      and contains(log.source, "/SYSLOG/APIGW/prod/local4.log", caseSensitive:false)
      and contains(content, "Problem routing to", caseSensitive:false)
      and contains(content, "timed out", caseSensitive:false)
      and contains(content, "myaxa-api.alj.intraxa", caseSensitive:false)
    )
| summarize timeouts = count(), by:{ window = bin(timestamp, 5m) }
| sort timeouts desc
| limit 20
