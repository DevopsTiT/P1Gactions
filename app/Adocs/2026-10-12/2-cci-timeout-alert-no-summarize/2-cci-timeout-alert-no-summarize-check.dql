// 1. Does the field aws.log_group exist, and what are the exact values?
fetch logs, from:now()-24h
| filter contains(toString(aws.log_group), "cci-fa-comm-calc")
| summarize lines = count(), by:{ aws.log_group }

// 2. Did the timeout message appear recently? (Expect 0 rows if all is healthy.)
fetch logs, from:now()-7d
| filter contains(aws.log_group, "cci-fa-comm-calc")
| filter contains(content, "Task timed out", caseSensitive:false)
| filter not contains(content, "[DEBUG]")
| fields timestamp, aws.log_group, content
| sort timestamp desc
| limit 50
