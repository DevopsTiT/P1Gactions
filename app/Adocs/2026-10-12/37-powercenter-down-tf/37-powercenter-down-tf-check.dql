// 1. Which hosts and files carry ISP_MASTER_ELECT_LOCK?
fetch logs, from:now()-7d
| filter contains(content, "ISP_MASTER_ELECT_LOCK", caseSensitive:false)
| summarize lines = count(), sample = takeFirst(content), by:{ host.name, log.source }

// 2. Minutes with more than 3 lines over 30 days
fetch logs, from:now()-30d
| filter contains(content, "ISP_MASTER_ELECT_LOCK", caseSensitive:false)
| summarize lock_events = count(), by:{ minute = bin(timestamp, 1m) }
| filter lock_events > 3
| sort minute desc
| limit 50
