// 1. Exact host name and source path in Dynatrace (alert screen reads CEAA2088, events read CEAA20B8)
fetch logs, from:now()-24h
| filter contains(host.name, "CEAA20", caseSensitive:false)
| filter contains(log.source, "pisp2", caseSensitive:false)
| summarize lines = count(), by:{ host.name, log.source }

// 2. The detector query over 30 days. Splunk found 18 events
fetch logs, from:now()-30d
| filter contains(host.name, "CEAA20B8", caseSensitive:false)
| filter contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/pisp2.log", caseSensitive:false)
| filter contains(content, "errorCode") and contains(content, "ESG120")
| fields timestamp, host.name, log.source, content

// 3. Is the JSON split across lines in Dynatrace? If ESG120 and errorCode land on different records, use only contains(content, "ESG120")
fetch logs, from:now()-30d
| filter contains(log.source, "pisp2", caseSensitive:false)
| filter contains(content, "ESG120")
| fields timestamp, content
| limit 10
