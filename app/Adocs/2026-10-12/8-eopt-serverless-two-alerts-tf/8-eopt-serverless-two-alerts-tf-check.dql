// 1. Which log groups contain "eopt-serverless"
fetch logs, from:now()-24h
| filter contains(toString(aws.log_group), "eopt-serverless")
| summarize lines = count(), by:{ aws.log_group }

// 2. "ERROR" matches: real error lines vs. the word "error" inside normal text
fetch logs, from:now()-7d
| filter contains(aws.log_group, "eopt-serverless")
| filter contains(content, "ERROR", caseSensitive:false)
| fieldsAdd upper_case_ERROR = contains(content, "ERROR")
| summarize hits = count(), by:{ upper_case_ERROR, loglevel }

// 3. Sample lines
fetch logs, from:now()-7d
| filter contains(aws.log_group, "eopt-serverless")
| filter contains(content, "ERROR", caseSensitive:false)
| fields timestamp, loglevel, content
| sort timestamp desc
| limit 50
