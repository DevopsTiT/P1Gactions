// 1. Do frontend lines parse as JSON, and what levels exist?
fetch logs, from:now()-1h
| filter startsWith(host.name, "eoptfrontend-")
| parse content, "JSON:j"
| fieldsAdd level = upper(toString(j[level]))
| summarize lines = count(), by:{ level, loglevel }

// 2. Raw frontend lines, to see the JSON keys
fetch logs, from:now()-1h
| filter startsWith(host.name, "eoptfrontend-")
| fields timestamp, host.name, loglevel, content
| limit 10

// 3. ERROR lines per hour over 7 days
fetch logs, from:now()-7d
| filter startsWith(host.name, "eoptfrontend-")
| parse content, "JSON:j"
| fieldsAdd level = upper(toString(j[level]))
| filter level == "ERROR"
| makeTimeseries errors = count(), interval:1h
