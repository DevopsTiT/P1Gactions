// 1. Which log groups contain "customer-process-api"
fetch logs, from:now()-24h
| filter contains(toString(aws.log_group), "customer-process-api")
| summarize lines = count(), by:{ aws.log_group }

// 2. How statusCode 201 looks in the log text
fetch logs, from:now()-7d
| filter contains(aws.log_group, "customer-process-api")
| filter contains(content, "statusCode")
| filter contains(content, "201")
| fields timestamp, content
| sort timestamp desc
| limit 20

// 3. Which Alert 2 messages fired in the last 7 days
fetch logs, from:now()-7d
| filter contains(aws.log_group, "customer-process-api")
| fieldsAdd matched = if(contains(content, "Task timed out", caseSensitive:false), "Task timed out",
    else: if(contains(content, "An error occurred", caseSensitive:false), "An error occurred",
    else: if(contains(content, "Failed to handle: lifeJData", caseSensitive:false), "Failed to handle: lifeJData",
    else: if(contains(content, "Got unexpected investment company code", caseSensitive:false), "Unexpected investment company code",
    else: if(contains(content, "The policy is ineligible for creating a request", caseSensitive:false), "Policy ineligible",
    else: if(contains(content, "IBL0250002", caseSensitive:false), "IBL0250002",
    else: if(contains(content, "<StatusCd>EB", caseSensitive:false), "StatusCd EB",
    else: if(contains(content, "imported a total of 0 data", caseSensitive:false), "Imported 0 data",
    else: if(contains(content, "Handler Error: Too many connections", caseSensitive:false), "Too many connections")))))))))
| filter isNotNull(matched)
| summarize hits = count(), last_seen = max(timestamp), by:{ matched }
| sort hits desc
