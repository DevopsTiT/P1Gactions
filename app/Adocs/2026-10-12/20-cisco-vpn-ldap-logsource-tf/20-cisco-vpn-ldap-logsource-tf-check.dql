// 1. Do the four ASA files show up in Dynatrace? (Splunk: ALJ, ADJ, VASA19, VASA17)
fetch logs, from:now()-24h
| filter contains(log.source, "/var/log/ASA", caseSensitive:false)
| summarize lines = count(), by:{ log.source }

// 2. The detector query over 35 days. Splunk found 2 events from 9/12 to 10/12
fetch logs, from:now()-35d
| filter contains(log.source, "/var/log/ASA", caseSensitive:false)
| filter contains(content, "Windows_LDAP as FAILED", caseSensitive:false)
| fields timestamp, log.source, content
