// 1. Where are the eopt pod names stored, and which services exist?
fetch logs, from:now()-1h
| fieldsAdd pod = coalesce(k8s.pod.name, host.name)
| filter startsWith(pod, "eopt")
| summarize lines = count(), by:{ host.name, k8s.pod.name, k8s.workload.name }

// 2. Does the parse work? Expect levels like DEBUG, INFO, WARN, ERROR
fetch logs, from:now()-1h
| fieldsAdd pod = coalesce(k8s.pod.name, host.name)
| filter startsWith(pod, "eoptsystemapi-") or startsWith(pod, "eoptprocessapi-")
| parse content, "NSPACE:log_ts SPACE+ ALPHA:level"
| summarize lines = count(), sample_ts = takeFirst(log_ts), by:{ level }

// 3. ERROR lines per hour per service over 7 days
fetch logs, from:now()-7d
| fieldsAdd pod = coalesce(k8s.pod.name, host.name)
| filter startsWith(pod, "eoptsystemapi-") or startsWith(pod, "eoptprocessapi-")
| parse content, "NSPACE:log_ts SPACE+ ALPHA:level"
| filter level == "ERROR"
| fieldsAdd service = if(startsWith(pod, "eoptsystemapi-"), "eoptsystemapi", else:"eoptprocessapi")
| makeTimeseries errors = count(), by:{ service }, interval:1h

// 4. Does the frontend also log ERROR? Decide whether to add eoptfrontend-
fetch logs, from:now()-7d
| fieldsAdd pod = coalesce(k8s.pod.name, host.name)
| filter startsWith(pod, "eoptfrontend-")
| parse content, "NSPACE:log_ts SPACE+ ALPHA:level"
| filter level == "ERROR"
| summarize errors = count(), sample = takeFirst(content)
