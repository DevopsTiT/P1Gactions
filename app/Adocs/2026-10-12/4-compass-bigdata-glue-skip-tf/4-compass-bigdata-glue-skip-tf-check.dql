// 1. Exact log group value
fetch logs, from:now()-24h
| filter contains(toString(aws.log_group), "compass-sales-performance")
| summarize lines = count(), by:{ aws.log_group }

// 2. Past "skipping table" lines
fetch logs, from:now()-7d
| filter contains(aws.log_group, "/aws-glue/jobs/custom/compass-sales-performance/error")
| filter contains(content, "skipping table", caseSensitive:false)
| fields timestamp, aws.log_group, content
| sort timestamp desc
| limit 100
