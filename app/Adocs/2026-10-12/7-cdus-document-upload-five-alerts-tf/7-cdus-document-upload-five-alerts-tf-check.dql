// 1. Which log groups exist for document-upload-api
fetch logs, from:now()-24h
| filter contains(toString(aws.log_group), "document-upload-api")
| summarize lines = count(), by:{ aws.log_group }

// 2. Alerts 1 and 5 (same query): how often would they have paged in 7 days?
fetch logs, from:now()-7d
| filter contains(aws.log_group, "/aws/lambda/document-upload-api")
| filter contains(content, "Error Report", caseSensitive:false)
    or contains(content, "ExitError", caseSensitive:false)
| makeTimeseries hits = count(), interval:1h

// 3. Alert 2: are "action:" + "cmxDocumentId:" lines failures or normal uploads?
fetch logs, from:now()-24h
| filter contains(aws.log_group, "/aws/lambda/document-upload-api-prod-createDocumentAction")
| filter contains(content, "action:", caseSensitive:false)
| filter contains(content, "cmxDocumentId:", caseSensitive:false)
| fields timestamp, loglevel, content
| sort timestamp desc
| limit 50

// 4. Alert 3: what does "ETIM" match? (look for dateTime, lifetime and similar)
fetch logs, from:now()-7d
| filter contains(aws.log_group, "/aws/lambda/document-upload-api-prod-")
| filter contains(content, "ETIM", caseSensitive:false)
| fieldsAdd real_timeout = contains(content, "ETIMEDOUT")
| summarize hits = count(), by:{ real_timeout }

// 5. Alert 4: past CMX creation failures
fetch logs, from:now()-7d
| filter contains(aws.log_group, "/aws/lambda/document-upload-api-prod-")
| filter contains(content, "Failed to create CMX Document", caseSensitive:false)
| fields timestamp, aws.log_group, content
| sort timestamp desc
| limit 50
