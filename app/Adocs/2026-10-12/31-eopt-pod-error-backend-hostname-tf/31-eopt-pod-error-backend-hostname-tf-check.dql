// 1. Hosts per service (expect 12 hosts: systemapi, processapi, frontend)
fetch logs, from:now()-1h
| filter startsWith(host.name, "eopt")
| summarize lines = count(), by:{ host.name }

// 2. Parse check: level counts (expect DEBUG, INFO, WARN, ERROR)
fetch logs, from:now()-1h
| filter startsWith(host.name, "eoptsystemapi-") or startsWith(host.name, "eoptprocessapi-") or startsWith(host.name, "eoptfrontend-")
| parse content, "NSPACE:log_ts SPACE+ ALPHA:level"
| summarize lines = count(), by:{ level }

// 3. ERROR lines per hour per service over 7 days
fetch logs, from:now()-7d
| filter startsWith(host.name, "eoptsystemapi-") or startsWith(host.name, "eoptprocessapi-") or startsWith(host.name, "eoptfrontend-")
| parse content, "NSPACE:log_ts SPACE+ ALPHA:level"
| filter level == "ERROR"
| fieldsAdd service = if(startsWith(host.name, "eoptsystemapi-"), "eoptsystemapi", else: if(startsWith(host.name, "eoptprocessapi-"), "eoptprocessapi", else: "eoptfrontend"))
| makeTimeseries errors = count(), by:{ service }, interval:1h
