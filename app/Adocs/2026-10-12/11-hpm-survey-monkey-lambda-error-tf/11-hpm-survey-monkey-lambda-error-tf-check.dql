// 1. Exact log group value
fetch logs, from:now()-24h
| filter contains(toString(aws.log_group), "hpm-survey-monkey")
| summarize lines = count(), by:{ aws.log_group }

// 2. Real ERROR lines vs. the word "error" inside normal text
fetch logs, from:now()-7d
| filter contains(aws.log_group, "/aws/lambda/hpm-survey-monkey")
| filter contains(content, "ERROR", caseSensitive:false)
| fieldsAdd upper_case_ERROR = contains(content, "ERROR")
| summarize hits = count(), by:{ upper_case_ERROR, loglevel }

// 3. Sample lines
fetch logs, from:now()-7d
| filter contains(aws.log_group, "/aws/lambda/hpm-survey-monkey")
| filter contains(content, "ERROR", caseSensitive:false)
| fields timestamp, content
| sort timestamp desc
| limit 50
