// 1. Which log groups match "cs-digital-document-management"
fetch logs, from:now()-24h
| filter contains(toString(aws.log_group), "cs-digital-document-management")
| summarize lines = count(), by:{ aws.log_group }

// 2. Alert 2: lines missed because "error" is case-sensitive
fetch logs, from:now()-7d
| filter contains(aws.log_group, "/aws/lambda/cs-digital-document-management-prod")
| filter contains(content, "error", caseSensitive:false)
| filter not contains(content, "error")
| filter not contains(content, "elivery not possible", caseSensitive:false)
| fields timestamp, content
| sort timestamp desc
| limit 50

// 3. Alert 1: what would have alerted in the last 24 hours
fetch logs, from:now()-24h
| filter contains(aws.log_group, "cs-digital-document-management")
| filter contains(content, "error", caseSensitive:false)
| filter not contains(content, "elivery not possible", caseSensitive:false)
| filter not contains(content, "errorEmailNotification", caseSensitive:false)
| fields timestamp, aws.log_group, content
| sort timestamp desc
| limit 100
