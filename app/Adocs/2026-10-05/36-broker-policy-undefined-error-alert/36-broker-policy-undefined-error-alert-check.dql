// Query 1: find where the broker policy logs land (namespace, pod, log.source)
fetch logs, from:now()-24h
| filter contains(content, "Cannot read properties of undefined", caseSensitive: false)
| summarize lines = count(), by:{k8s.namespace.name, k8s.pod.name, log.source}
| sort lines desc
| limit 20

// Query 2: errors per minute over 7 days (how often would > 50 have fired?)
fetch logs, from:now()-7d
| filter k8s.namespace.name == "brokerpolicymaintenance-prod-axa-li-jp"
| filter contains(content, "Cannot read properties of undefined", caseSensitive: false)
| makeTimeseries count = count(default: 0), interval:1m

// Query 3: busiest minutes, to sanity-check the threshold of 50
fetch logs, from:now()-7d
| filter k8s.namespace.name == "brokerpolicymaintenance-prod-axa-li-jp"
| filter contains(content, "Cannot read properties of undefined", caseSensitive: false)
| fieldsAdd minute = bin(timestamp, 1m)
| summarize per_minute = count(), by:{minute}
| sort per_minute desc
| limit 20

// Query 4: sample error lines (which pod, which code path)
fetch logs, from:now()-24h
| filter k8s.namespace.name == "brokerpolicymaintenance-prod-axa-li-jp"
| filter contains(content, "Cannot read properties of undefined", caseSensitive: false)
| fields timestamp, k8s.pod.name, content
| sort timestamp desc
| limit 20
