// Run in a Notebook with timeframe Last 7 days.

// 1. Where do the lines live? Replace the guess in the .tf with the real field value.
fetch logs
| filter contains(content, "ISP_MASTER_ELECT_LOCK", caseSensitive: false)
| summarize lines = count(), by:{ dt.system.bucket, log.source, host.name, dt.entity.host }

// 2. Is it rare (real outage) or constant background? Peaks per minute.
fetch logs
| filter contains(content, "ISP_MASTER_ELECT_LOCK", caseSensitive: false)
| summarize per_minute = count(), by:{ minute = bin(timestamp, 1m) }
| summarize minutes_with_lines = count(), max_per_minute = max(per_minute), minutes_over_2 = countIf(per_minute > 2), minutes_over_3 = countIf(per_minute > 3)

// 3. Read a few raw lines to see what the message actually says.
fetch logs
| filter contains(content, "ISP_MASTER_ELECT_LOCK", caseSensitive: false)
| sort timestamp desc
| limit 20
| fields timestamp, host.name, log.source, content
