// Run in a Notebook over the last 7 days. If parsed_error is much lower than raw_error,
// the parse pattern does not match the real InnoRules log line format.
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/innorules-prod"
| filter contains(content, "ERROR")
| parse content, "LD SPACE LD SPACE WORD:loglevel"
| summarize raw_error = count(), parsed_error = countIf(loglevel == "ERROR"), status_error = countIf(status == "ERROR")

// Sample lines that contain ERROR but did not parse as level ERROR
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/innorules-prod"
| filter contains(content, "ERROR")
| parse content, "LD SPACE LD SPACE WORD:loglevel"
| filter isNull(loglevel) or loglevel != "ERROR"
| fields timestamp, loglevel, content
| limit 20
