// Query 1: where do batch_monitoring lines land?
fetch logs, from:now()-24h
| filter contains(log.source, "batch_monitoring") or contains(content, "batch_monitoring")
| summarize lines = count(), by:{log.source, dt.system.bucket}
| sort lines desc
| limit 20

// Query 2: today's lines (what the Splunk email used to list), JST time
fetch logs, from:now()-24h
| filter matchesValue(log.source, "*batch_monitoring*")
| sort timestamp asc
| fieldsAdd time_jst = formatTimestamp(timestamp, format:"yyyy-MM-dd HH:mm:ss", timezone:"Asia/Tokyo")
| fields time_jst, content
| limit 500

// Query 3: when do lines arrive? (shows how many problems per day the detector would open)
fetch logs, from:now()-7d
| filter matchesValue(log.source, "*batch_monitoring*")
| makeTimeseries lines = count(default: 0), interval:10m

// Query 4: are there success lines too? (decide whether to filter failures only)
fetch logs, from:now()-7d
| filter matchesValue(log.source, "*batch_monitoring*")
| summarize lines = count(), by:{loglevel}
| sort lines desc
