// 1) Old parse vs fixed parse on Lambda REPORT lines (compare old_value with fixed_value)
fetch logs, from:now()-1d
| filter aws.log_group == "/aws/lambda/pmt-api-prod"
| filter contains(content, "Max Memory Used")
| parse content, "LD LD LD LD NUMBER:old_value"
| parse content, "LD 'Max Memory Used: ' INT:fixed_value"
| fields timestamp, old_value, fixed_value, content
| limit 20

// 2) Peak memory per hour over 7 days (how close to 480 MB it runs)
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/pmt-api-prod"
| filter contains(content, "Max Memory Used")
| parse content, "LD 'Max Memory Used: ' INT:memory_usage"
| makeTimeseries peak_mb = max(memory_usage), interval:1h

// 3) Prove alerts 6 and 7 match exactly the same lines
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/pmt-api-prod"
| filter contains(content, "Exception in myAxaMailSender", caseSensitive: false)
| summarize lines = count()

// 4) 7-day match counts for the other alerts
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/pmt-api-prod"
| summarize
    unexpected_error = countIf(contains(content, "Unexpected error", caseSensitive: false)),
    task_timed_out = countIf(contains(content, "Task timed out", caseSensitive: false)),
    approval_reminder_failed = countIf(contains(content, "SendApprovalReminder handler failed", caseSensitive: false)),
    sfdc_error = countIf(contains(content, "An error occurred while calling sfdc api", caseSensitive: false)),
    export_data_exception = countIf(contains(content, "Exception in ExportData", caseSensitive: false)),
    email_sending_error = countIf(contains(content, "Error occurred during email sending process for this user", caseSensitive: false))
