// Query 1: AGPO - where do the Auth0 password errors land?
fetch logs, from:now()-7d
| filter contains(content, "IamCChangePasswordBadRequestResponse") or contains(content, "IamCChangePasswordNotFoundResponse")
| summarize lines = count(), by:{k8s.namespace.name, k8s.pod.name, log.source}
| sort lines desc
| limit 20

// Query 2: EIP MQ - which hosts log "Connection timed out"?
fetch logs, from:now()-7d
| filter contains(content, "Connection timed out", caseSensitive: false)
| summarize lines = count(), by:{host.name, log.source}
| sort lines desc
| limit 20

// Query 3: Claims Auto-Assessment API - pod or host attribute?
fetch logs, from:now()-24h
| filter contains(content, "] ERROR ")
| filter contains(k8s.pod.name, "claims-auto-assessment-api") or contains(host.name, "claims-auto-assessment-api") or contains(log.source, "claims-auto-assessment-api")
| summarize lines = count(), by:{k8s.namespace.name, k8s.pod.name, host.name, log.source}
| sort lines desc
| limit 20

// Query 4: AGPO - 5-minute rolling count over 7 days (how often >= 2?)
fetch logs, from:now()-7d
| filter k8s.namespace.name == "agportalapi-prod-axa-li-jp"
| filter startsWith(k8s.pod.name, "agpo-cloud-authorization-process-api-")
| filter contains(content, "IamCChangePasswordBadRequestResponse") or contains(content, "IamCChangePasswordNotFoundResponse")
| makeTimeseries count = count(default: 0), interval:1m
| fieldsAdd count = arrayMovingSum(count, 5)

// Query 5: Claims - sample ERROR lines (what the Splunk email used to list)
fetch logs, from:now()-24h
| filter matchesValue(k8s.pod.name, "claims-auto-assessment-api*") or matchesValue(host.name, "claims-auto-assessment-api*")
| filter contains(content, "] ERROR ")
| filter not contains(content, "Error stacktraces are turned on")
| fields timestamp, k8s.pod.name, host.name, content
| sort timestamp asc
| limit 50
