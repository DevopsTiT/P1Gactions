// 1) Alert 2: how much each original OR part matches per day (shows how broad "started" is)
fetch logs, from:now()-14d
| filter aws.log_group == "/aws/lambda/sa-support-batches-prod"
| summarize
    runner = countIf(contains(content, "importFileHandler :: runner", caseSensitive: false)),
    saga_fund_group = countIf(contains(content, "importSagaFundGroup", caseSensitive: false)),
    started = countIf(contains(content, "started", caseSensitive: false)),
    runner_and_saga = countIf(contains(content, "importFileHandler :: runner", caseSensitive: false) and contains(content, "importSagaFundGroup", caseSensitive: false)),
    by:{ day = bin(timestamp, 1d) }
| sort day desc

// 2) Alert 2: sample the real import lines to decide the right match
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/sa-support-batches-prod"
| filter contains(content, "importFileHandler", caseSensitive: false) or contains(content, "importSagaFundGroup", caseSensitive: false)
| fields timestamp, content
| sort timestamp desc
| limit 30

// 3) Alert 1: how often "error" matches, and the top messages (noise check)
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/sa-support-batches-prod"
| filter contains(content, "error", caseSensitive: false)
| summarize n = count(), by:{ content }
| sort n desc
| limit 20
