// 1) Which log group name really exists? (only one of the two should return rows)
fetch logs, from:now()-7d
| filter in(aws.log_group, {"/aws/lambda/recrutimp-serverless-prod", "/aws/lambda/recruitimp-serverless-prod"})
| summarize lines = count(), by:{ aws.log_group }

// 2) Alert 1: old parse vs new filter
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/recruitimp-serverless-prod"
| parse content, "LD LD WORD:old_level"
| summarize
    old_parse_error = countIf(old_level == "ERROR"),
    status_error = countIf(status == "ERROR"),
    new_filter_error = countIf(status == "ERROR" or contains(content, "\tERROR\t") or contains(content, "[ERROR]"))

// 3) Alert 2: old parse (no SPACE) vs fixed parse
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/recruitimp-serverless-prod"
| parse content, "WORD:old_session WORD:old_level WORD:old_user"
| parse content, "NSPACE:session_id SPACE WORD:level SPACE NSPACE:user_id"
| summarize old_parse_error = countIf(old_level == "ERROR"), fixed_parse_error = countIf(level == "ERROR")

// 4) Sample lines to see the real RI log format
fetch logs, from:now()-7d
| filter aws.log_group == "/aws/lambda/recruitimp-serverless-prod"
| filter contains(content, "ERROR")
| fields timestamp, content
| limit 20
