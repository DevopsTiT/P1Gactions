// 1. Does the tempname parse work on group-jobs runs?
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "group-jobs")
| parse content, "JSON:j"
| fieldsAdd job_name = toString(j[job_name]), job_result = toString(j[job_result])
| parse content, "LD '\"name\":\"Building ' LD:tempname '\"'"
| fields timestamp, job_name, job_result, tempname
| limit 50

// 2. Compass rows in configuration (compare "Compass" with "Compass AG")
load "/lookups/jenkins/configuration"
| filter contains(application, "Compass")
| summarize jobs = count(), by:{ application }
