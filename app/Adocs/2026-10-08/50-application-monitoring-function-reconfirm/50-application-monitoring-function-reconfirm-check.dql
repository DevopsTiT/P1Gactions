// 1. Do jenkins_statistics build events carry build_url?
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "job_duration")
| filter not contains(content, "audit_trail")
| parse content, "JSON:j"
| fieldsAdd job_name = toString(j[job_name]), build_url = toString(j[build_url])
| filter matchesValue(job_name, "applications*")
| fields timestamp, job_name, build_url
| limit 20

// 2. Do jenkins_console maintenance lines reach Grail, and which field holds the console path?
fetch logs, from:now()-7d
| filter contains(content, "Application is in mantenance")
| fields timestamp, host.name, log.source, source, content
| limit 20

// 3. Apps covered by this alert (pager_duty = 0)
load "/lookups/jenkins/configuration"
| filter toString(pager_duty) == "0"
| summarize jobs = count(), by:{ application }
| sort application asc
