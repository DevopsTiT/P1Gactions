// 1. MQ error log: host and file in Dynatrace
fetch logs, from:now()-1d
| filter matchesValue(host.name, "wpalja21b*") or contains(log.source, "/var/mqm/qmgrs/")
| summarize lines = count(), by:{ host.name, log.source }

// 2. AGPO auth pods: where does the pod name land?
fetch logs, from:now()-1h
| filter contains(host.name, "agpo-cloud-authorization-process-api") or contains(k8s.pod.name, "agpo-cloud-authorization-process-api")
| summarize lines = count(), by:{ host.name, k8s.pod.name, log.source }

// 3. MQ connection timeouts over 7 days
fetch logs, from:now()-7d
| filter matchesValue(host.name, "wpalja21b*")
| filter contains(content, "Connection timed out", caseSensitive:false)
| fields timestamp, host.name, log.source, content
| sort timestamp desc

// 4. AGPO password sync errors per 5 minutes over 7 days (how often count > 1?)
fetch logs, from:now()-7d
| filter startsWith(host.name, "agpo-cloud-authorization-process-api-") or startsWith(k8s.pod.name, "agpo-cloud-authorization-process-api-")
| filter contains(content, "IamCChangePasswordBadRequestResponse", caseSensitive:false)
      or contains(content, "IamCChangePasswordNotFoundResponse", caseSensitive:false)
| makeTimeseries errors = count(), interval:5m
