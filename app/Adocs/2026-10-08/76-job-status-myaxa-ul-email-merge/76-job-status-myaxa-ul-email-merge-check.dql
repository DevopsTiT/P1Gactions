// Query 1: log.source for controlm_activejobs
fetch logs, from:now()-7d
| filter contains(content, "CHDE010M")
| summarize events = count(), by:{ log.source, host.name }

// Query 2: field shapes on CHDE010M rows (odate should be 6 digits, start_time / end_time 14 digits)
fetch logs, from:now()-35d
| filter matchesValue(log.source, "*controlm_activejobs*")
| filter job_name == "CHDE010M"
| fields timestamp, job_name, status, odate, start_time, end_time, order_id
| sort timestamp desc
| limit 50

// Query 3: dry run without the time gate (latest status per order date over 35 days)
fetch logs, from:now()-35d
| filter matchesValue(log.source, "*controlm_activejobs*")
| filter job_name == "CHDE010M"
| sort timestamp asc
| summarize status = takeLast(status), start_time = takeLast(start_time), end_time = takeLast(end_time), by:{ job_name, odate }
| fieldsAdd MSG = if(status == "Ended OK", "OK", else: "正常終了していません要確認")
| sort odate desc

// Query 4: what the time gate sees right now
fetch logs, from:now()-1m
| limit 1
| fields yesterday_odate = formatTimestamp(now() - 1d, format:"yyMMdd", timezone:"Asia/Tokyo"),
         jst_hhmm = formatTimestamp(now(), format:"HHmm", timezone:"Asia/Tokyo"),
         jst_day_of_week = getDayOfWeek(now() + 9h)
