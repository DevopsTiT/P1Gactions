// 1. Where UserInfoService EIP lines land, and whether API_VERSION / RESPONSE_CODE are attributes
fetch logs, from:now()-1h
| filter contains(content, "jp-Distributing-Sell-UserInfoService-v1-vs")
| fields timestamp, host.name, log.source, API_VERSION, RESPONSE_CODE, content
| limit 20

// 2. Responses per code per hour over 7 days (how often 500 happens normally)
fetch logs, from:now()-7d
| filter contains(content, "jp-Distributing-Sell-UserInfoService-v1-vs")
| parse content, "LD 'RESPONSE_CODE' LD:sep INT:code"
| fieldsAdd code = coalesce(toString(RESPONSE_CODE), toString(code))
| makeTimeseries calls = count(), by:{ code }, interval:1h

// 3. Same filter as the detector, last 24 hours
fetch logs, from:now()-24h
| filter contains(content, "jp-Distributing-Sell-UserInfoService-v1-vs")
      or toString(API_VERSION) == "jp-Distributing-Sell-UserInfoService-v1-vs"
| filter toString(RESPONSE_CODE) == "500"
      or contains(content, "RESPONSE_CODE=500")
      or contains(content, "RESPONSE_CODE=\"500\"")
      or contains(content, "\"RESPONSE_CODE\":500")
      or contains(content, "\"RESPONSE_CODE\":\"500\"")
| fields timestamp, host.name, log.source, content
| limit 20
