// 1. What do "[HTTP Monitor]" lines look like, and where is the console path?
fetch logs, from:now()-1h
| filter contains(content, "[HTTP Monitor]")
| fields timestamp, host.name, log.source, content
| limit 20

// 2. Runs per job in 15 minutes and parsed status codes (should be 2+ runs per job)
fetch logs, from:now()-15m
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "[HTTP Monitor]")
| parse content, "LD 'status=' INT:responsecode"
| fieldsAdd name = replacePattern(replaceString(replaceString(toString(log.source), "job/", ""), "%20", " "), "'/' INT '/console' EOS", "")
| summarize runs = count(), codes = collectDistinct(responsecode), by:{ name }
| sort runs asc

// 3. Jobs in configuration that the lookup should match
load "/lookups/jenkins/configuration"
| fields job_name, application, pager_duty
| limit 50
