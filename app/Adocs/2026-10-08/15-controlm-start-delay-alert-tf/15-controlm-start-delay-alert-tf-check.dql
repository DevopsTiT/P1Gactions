// 1. Do Start Time Delay events reach Dynatrace, and from which source?
fetch logs, from:now()-7d
| filter contains(content, "Start Time Delay", caseSensitive:false)
| summarize lines = count(), last_seen = max(timestamp), by:{ host.name, log.source }

// 2. Are the Control-M fields real attributes? (current_time should be yyyyMMddHHmmss)
fetch logs, from:now()-7d
| filter matchesValue(log.source, "*controlm_alert*")
| filter contains(content, "Start Time Delay", caseSensitive:false)
| fields timestamp, job_name, data_center, application, run_counter, current_time, host_time, group_name, content
| limit 20

// 3. Are the three lookups uploaded with a job_name column?
load "/lookups/controlm/addresslist" | limit 5
load "/lookups/controlm/job_definition" | limit 5
load "/lookups/controlm/specific_contact" | limit 5

// 4. How many delay problems per day would the detector open? (chart, makeTimeseries is fine here)
fetch logs, from:now()-7d
| filter matchesValue(log.source, "*controlm_alert*")
| filter contains(content, "Start Time Delay", caseSensitive:false)
| makeTimeseries delays = count(), interval:1d
