// 1. Where does the pod name land? (host.name or k8s.pod.name)
fetch logs, from:now()-1h
| filter contains(host.name, "broker-policy-maintenance") or contains(k8s.pod.name, "broker-policy-maintenance")
| summarize lines = count(), by:{ host.name, k8s.pod.name, log.source }

// 2. Errors per minute over 7 days, peaks first (how often above 50?)
fetch logs, from:now()-7d
| filter startsWith(host.name, "broker-policy-maintenance-web") or startsWith(k8s.pod.name, "broker-policy-maintenance-web")
| filter contains(content, "Cannot read properties of undefined", caseSensitive:false)
| summarize count = count(), by:{ minute = bin(timestamp, 1m) }
| sort count desc
| limit 50

// 3. Sample error lines (which pod, which message)
fetch logs, from:now()-1d
| filter startsWith(host.name, "broker-policy-maintenance-web") or startsWith(k8s.pod.name, "broker-policy-maintenance-web")
| filter contains(content, "Cannot read properties of undefined", caseSensitive:false)
| fields timestamp, host.name, k8s.pod.name, content
| limit 20
