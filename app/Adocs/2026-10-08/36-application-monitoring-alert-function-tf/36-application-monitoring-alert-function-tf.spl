index=jenkins_console source="job/applications/job/*" "Application is in mantenance" earliest=-7d | rex field=source "(?P<build_url>.*)console" | stats count values(_raw) as remarks by build_url
index=jenkins_statistics sourcetype="json:jenkins:old" job_name=applications* earliest=-1d | where isnotnull(job_duration) | table _time job_name build_url job_result
| inputlookup configuration | search pager_duty="0" | stats count by application
| rest /servicesNS/-/-/saved/searches | search title="Application Monitoring Alert - function" | table title actions action.* alert.*
