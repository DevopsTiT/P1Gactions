// 1. Is datalake_transfer.log reaching Dynatrace? Which host and exact path?
fetch logs, from:now()-2d
| filter contains(log.source, "datalake_transfer")
| summarize lines = count(), by:{host.name, log.source}

// 2. Last night's lines in Japan time (same as the Splunk email)
fetch logs, from:now()-1d
| filter contains(log.source, "datalake_transfer.log")
| fieldsAdd jst = formatTimestamp(timestamp, format:"yyyy-MM-dd HH:mm:ss", timezone:"Asia/Tokyo")
| fields jst, host.name, content
| sort jst asc

// 3. Lines per night over 30 days (expect 8)
fetch logs, from:now()-30d
| filter contains(log.source, "datalake_transfer.log")
| summarize lines = count(), by:{day = formatTimestamp(timestamp, format:"yyyy-MM-dd", timezone:"Asia/Tokyo")}
| sort day desc

// 4. Failed steps over 30 days
fetch logs, from:now()-30d
| filter contains(log.source, "datalake_transfer.log")
| filter contains(content, "Failed")
| summarize count(), by:{content}
