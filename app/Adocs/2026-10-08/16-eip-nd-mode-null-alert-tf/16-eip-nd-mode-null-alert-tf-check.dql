// 1. Where do EIP ND Mode logs arrive?
fetch logs, from:now()-1d
| filter contains(log.source, "nd_mode") or contains(content, "ACTIVEMQMODE")
| summarize lines = count(), last_seen = max(timestamp), by:{ host.name, log.source }

// 2. Is ACTIVEMQMODE an attribute, and which values appear?
fetch logs, from:now()-1d
| filter matchesValue(log.source, "*eip_nd_mode*")
| summarize lines = count(), by:{ ACTIVEMQMODE }

// 2b. If ACTIVEMQMODE is null in query 2, look at raw lines and parse from content
fetch logs, from:now()-1d
| filter matchesValue(log.source, "*eip_nd_mode*")
| fields timestamp, content
| limit 20

// 3. Would the detector have fired? Count per 10 minutes over a day (chart)
fetch logs, from:now()-1d
| filter matchesValue(log.source, "*eip_nd_mode*")
| filter isNotNull(ACTIVEMQMODE) and ACTIVEMQMODE != "" and ACTIVEMQMODE != "NULL"
| makeTimeseries event_count = count(), interval:10m
