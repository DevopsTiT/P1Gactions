// 1. Which jobs match "management", how often they run, and their results (last 24 hours)
fetch logs, from:now()-24h
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "build_report")
| parse content, "JSON:j"
| fieldsAdd job_name = toString(j[job_name]), job_result = toString(j[job_result])
| filter isNotNull(job_name) and contains(lower(job_name), "management")
| summarize runs = count(), results = collectDistinct(job_result), last_seen = max(timestamp), by:{ job_name }
| sort job_name asc

// 2. Do build_report events carry a "status" field at all? (Splunk's responsecode comes from it)
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "build_report")
| parse content, "JSON:j"
| fieldsAdd job_name = toString(j[job_name]), has_status = isNotNull(j[status])
| filter contains(lower(job_name), "management")
| summarize count(), by:{ has_status }

// 3. Runs per matched job in the last 60 minutes (need at least 2 each)
fetch logs, from:now()-60m
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "build_report")
| parse content, "JSON:j"
| fieldsAdd job_name = toString(j[job_name]), job_result = toString(j[job_result])
| filter isNotNull(job_name) and contains(lower(job_name), "management")
| summarize runs = count(), fails = countIf(job_result != "SUCCESS"), by:{ job_name }
