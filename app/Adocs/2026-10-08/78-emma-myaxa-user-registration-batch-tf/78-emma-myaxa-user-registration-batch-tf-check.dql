// 1. When CHDR010M runs and ends (decides the 1-day range and the 06:00 gate)
fetch logs, from:now()-14d
| filter matchesValue(log.source, "*controlm_activejobs*")
| filter job_name == "CHDR010M"
| sort timestamp asc
| summarize status = takeLast(status), start_time = takeLast(start_time), end_time = takeLast(end_time), last_seen = max(timestamp), by:{ job_name, odate }
| sort odate desc

// 2. Field formats on CHDR010M rows (odate present, start_time / end_time 14 digits)
fetch logs, from:now()-2d
| filter matchesValue(log.source, "*controlm_activejobs*")
| filter job_name == "CHDR010M"
| fields timestamp, job_name, odate, order_id, status, start_time, end_time
| limit 20

// 3. Dry run without the time gate and without the status filter
fetch logs, from:now()-1d
| filter matchesValue(log.source, "*controlm_activejobs*")
| filter job_name == "CHDR010M"
| sort timestamp asc
| summarize status = takeLast(status), start_time = takeLast(start_time), end_time = takeLast(end_time), odate = takeLast(odate), by:{ job_name }
