// 1. Do "[HTTP Monitor]" lines exist, and what do they look like?
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "[HTTP Monitor]")
| fields timestamp, log.source, content
| limit 20

// 2. Runs per job in 15 minutes and parsed codes
fetch logs, from:now()-15m
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "[HTTP Monitor]")
| parse content, "LD 'status=' INT:responsecode"
| fieldsAdd name = replacePattern(replaceString(replaceString(toString(log.source), "job/", ""), "%20", " "), "'/' INT '/console' EOS", "")
| summarize runs = count(), codes = collectDistinct(responsecode), by:{ name }
| sort runs asc

// 3. What the detector would raise right now (run before enabling)
fetch logs, from:now()-15m
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "[HTTP Monitor]")
| parse content, "LD 'status=' INT:responsecode"
| filter isNotNull(responsecode)
| fieldsAdd name = replacePattern(replaceString(replaceString(toString(log.source), "job/", ""), "%20", " "), "'/' INT '/console' EOS", "")
| lookup [ load "/lookups/jenkins/configuration" ], sourceField:name, lookupField:job_name, prefix:"cfg.", fields:{ application, job_name }
| filter isNotNull(cfg.job_name)
| fieldsAdd code = toString(responsecode)
| summarize fails = countIf(code != "200"), oks = countIf(code == "200"), by:{ application = cfg.application, name }
| filter fails >= 2 and oks == 0
