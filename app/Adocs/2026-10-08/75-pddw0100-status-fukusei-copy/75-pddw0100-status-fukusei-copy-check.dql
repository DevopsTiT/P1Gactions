// 1. Where do Control-M active job logs arrive?
fetch logs, from:now()-1d
| filter contains(content, "PDDW")
| summarize lines = count(), by:{ log.source, host.name }

// 2. PDDW snapshot fields (current_time, odate, order_id, status, start_time, end_time)
fetch logs, from:now()-1d
| filter matchesValue(log.source, "*controlm_activejobs*")
| filter startsWith(job_name, "PDDW")
| fields timestamp, current_time, odate, order_id, job_name, status, start_time, end_time
| sort timestamp desc
| limit 30

// 3. Claims job list lookup columns
load "/lookups/controlm/claims_job_list"
| filter startsWith(job_id, "PDDW")
| limit 20

// 4. Latest status of every PDDW run over 7 days, with end time (which runs finish after 08:15?)
fetch logs, from:now()-7d
| filter matchesValue(log.source, "*controlm_activejobs*")
| filter startsWith(job_name, "PDDW")
| filter not endsWith(job_name, "-S") and not endsWith(job_name, "-F") and job_name != "TEST001"
| sort current_time asc
| summarize status = takeLast(status), job_name = takeLast(job_name), end_time = takeLast(end_time), by:{ odate, order_id }
| fieldsAdd end_hhmm = substring(end_time, from:8, to:12)
| sort end_hhmm desc
