// 1. Does CEAA204C send any logs to Dynatrace?
fetch logs, from:now()-7d
| filter matchesValue(host.name, "CEAA204C*")
| summarize lines = count(), last_seen = max(timestamp), by:{ host.name, log.source }

// 2. Has RETURN_CD:2 appeared anywhere in 30 days (maybe on another host)?
fetch logs, from:now()-30d
| filter contains(content, "RETURN_CD:2")
| summarize lines = count(), last_seen = max(timestamp), by:{ host.name, log.source }

// 3. Which RETURN_CD values exist (0 = OK, 2 = error?)
fetch logs, from:now()-7d
| filter contains(content, "RETURN_CD:")
| parse content, "LD 'RETURN_CD:' INT:return_cd"
| summarize lines = count(), by:{ host.name, return_cd }
