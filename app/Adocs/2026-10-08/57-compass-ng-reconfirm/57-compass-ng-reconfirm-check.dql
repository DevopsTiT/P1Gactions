// 1. Compass rows in configuration (Compass, not "Compass AG")
load "/lookups/jenkins/configuration"
| filter contains(application, "Compass")
| fields job_name, application, pager_duty

// 2. Compass build events the detector keeps (last day)
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "job_duration")
| filter not contains(content, "audit_trail")
| filter contains(lower(content), "compass")
| parse content, "JSON:j"
| fieldsAdd job_name = toString(j[job_name]), job_result = toString(j[job_result])
| summarize runs = count(), by:{ job_name, job_result }
| sort runs desc
