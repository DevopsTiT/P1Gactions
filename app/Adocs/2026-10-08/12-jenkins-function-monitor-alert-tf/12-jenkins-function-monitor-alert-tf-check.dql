// 1. Do Jenkins job statistics reach Dynatrace? Which sources?
fetch logs, from:now()-2h
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "job_name")
| summarize lines = count(), by:{ log.source }

// 2. JSON keys of the job events
fetch logs, from:now()-2h
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "job_name")
| parse content, "JSON:j"
| fields timestamp, log.source, job_name = j[job_name], job_result = j[job_result], job_duration = j[job_duration], build_url = j[build_url]
| limit 20

// 3. Job results by job prefix (do group-jobs have job_result at all?)
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "job_name")
| parse content, "JSON:j"
| fieldsAdd job_name = toString(j[job_name]), job_result = toString(j[job_result])
| filter matchesValue(job_name, "applications*") or matchesValue(job_name, "group-jobs*")
| summarize runs = count(), by:{ prefix = if(startsWith(job_name, "group-jobs"), "group-jobs", else:"applications"), job_result }

// 4. Builds in maintenance (Splunk joined these as remarks)
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(log.source, "job/applications/")
| filter contains(content, "Application is in mantenance") or contains(content, "Application is in maintenance")
| fields timestamp, log.source, content
| limit 20
