// 1. Do AGGW LB HTTP Monitor lines exist, and what do they look like?
fetch logs, from:now()-1d
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "[HTTP Monitor]")
| filter contains(content, "AGGW") or contains(toString(log.source), "AGGW")
| fields timestamp, log.source, content
| limit 20

// 2. 10-minute max response time over 24 hours (what the detector compares)
fetch logs, from:now()-24h
| filter matchesValue(host.name, "ceaa2099*")
| filter contains(content, "[HTTP Monitor]")
| filter contains(replaceString(toString(log.source), "%20", " "), "HTTP Monitor - AGGW LB")
| parse content, "LD 'duration=' DOUBLE:duration"
| makeTimeseries responsetime = max(duration), interval:10m
