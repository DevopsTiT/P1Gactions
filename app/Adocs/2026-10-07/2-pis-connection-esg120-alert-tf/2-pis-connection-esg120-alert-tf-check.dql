// 1. Is the PIS batch log in Dynatrace? (Splunk: host CEAA20B8, /IFDATA/DATA/PC/LOG/PISP2/pisp2.log)
fetch logs, from:now()-1h
| filter contains(log.source, "PISP2") or matchesValue(host.name, "CEAA20*")
| summarize count(), by:{host.name, log.source}

// 2. Detector query over 30 days: past ESG120 lines
fetch logs, from:now()-30d
| filter contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/") or matchesValue(host.name, "CEAA20B8*")
| filter contains(content, "\"errorCode\": \"ESG120\"")
| fields timestamp, host.name, content
| sort timestamp desc

// 3. Spacing check: any ESG120 line the exact match above would miss (tab or no space after the colon)
fetch logs, from:now()-30d
| filter contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/")
| filter contains(content, "ESG120") and not contains(content, "\"errorCode\": \"ESG120\"")
| fields timestamp, content
