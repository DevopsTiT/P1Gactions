// 1. Which eopt pods write JSON lines? (frontend pod names)
fetch logs, from:now()-1d
| filter startsWith(host.name, "eopt")
| parse content, "JSON:j"
| fieldsAdd is_json = isNotNull(j)
| summarize count(), by:{host.name, is_json}

// 2. Level values in the JSON lines (expect info, warn, error in some case)
fetch logs, from:now()-7d
| filter startsWith(host.name, "eopt")
| parse content, "JSON:j"
| filter isNotNull(j)
| summarize count(), by:{level = toString(j[level])}

// 3. Detector query over 7 days: frontend ERROR lines
fetch logs, from:now()-7d
| filter startsWith(host.name, "eopt")
| parse content, "JSON:j"
| filter upper(toString(j[level])) == "ERROR"
| fields timestamp, host.name, content
| sort timestamp desc

// 4. Does Dynatrace already parse the JSON level into loglevel? If yes, loglevel == "ERROR" is simpler
fetch logs, from:now()-1d
| filter startsWith(host.name, "eopt")
| summarize count(), by:{host.name, loglevel}
