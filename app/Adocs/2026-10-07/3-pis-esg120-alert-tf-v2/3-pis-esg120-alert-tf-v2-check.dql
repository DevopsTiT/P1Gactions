// 1. Is pisp2.log in Dynatrace, and under which host name?
fetch logs, from:now()-1h
| filter contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/")
| summarize count(), by:{host.name, log.source}

// 2. Detector query over 2 days: should show the 5 events from 10/6
fetch logs, from:now()-2d
| filter contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/")
| filter contains(content, "\"errorCode\": \"ESG120\"")
| fields timestamp, host.name, content
| sort timestamp desc

// 3. Is the multi-line event one record or split per line? (look for "Routing failed" in the same record)
fetch logs, from:now()-2d
| filter contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/")
| filter contains(content, "ESG120")
| fieldsAdd same_record = contains(content, "Routing failed")
| fields timestamp, same_record, content
