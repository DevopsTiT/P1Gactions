// ============================================================
// Verify #3 — BC2 GMO Duplicate Order IDs
// sample from match-examples
// Pass: >=1 row (or expected summarize/group row). Fail: 0 rows.
// ============================================================
data record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "bc2-payment-prod-6d8f7b9c5-abcde",
    k8s.pod.name: "bc2-payment-prod-6d8f7b9c5-abcde",
    log.source: "/var/log/bc2/payment.log",
    content: "2026-10-15 09:12:34,567 INFO [http-nio-8080-exec-5] Integration.GMO - Map returned by method call: [acs=0&paytimes=&tranid=2610150912345678&clientfield3=&clientfield2=&method=1&clientfield1=&orderid=ORD-20261015-PA001091234-01&trandate=20261015091234&forward=2a99662]"
  ),
  record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "bc2-payment-prod-6d8f7b9c5-abcde",
    k8s.pod.name: "bc2-payment-prod-6d8f7b9c5-abcde",
    log.source: "/var/log/bc2/payment.log",
    content: "2026-10-15 09:13:01,204 INFO [http-nio-8080-exec-7] Integration.GMO - Map returned by method call: [acs=0&paytimes=&tranid=2610150913017788&clientfield3=&clientfield2=&method=1&clientfield1=&orderid=ORD-20261015-PA001091301-01&trandate=20261015091301&forward=2a99662]"
  ),
  record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "bc2-payment-prod-6d8f7b9c5-fghij",
    k8s.pod.name: "bc2-payment-prod-6d8f7b9c5-fghij",
    log.source: "/var/log/bc2/payment.log",
    content: "2026-10-15 09:20:45,880 INFO [http-nio-8080-exec-2] Integration.GMO - Map returned by method call: [acs=0&paytimes=&tranid=2610150920451234&clientfield3=&clientfield2=&method=1&clientfield1=&orderid=ORD-20261015-PB777092045-01&trandate=20261015092045&forward=2a99662]"
  )
| filter startsWith(host.name, "bc2-") or startsWith(k8s.pod.name, "bc2-")
| filter contains(content, "Integration.GMO")
    and contains(content, "Map returned by method call", caseSensitive:false)
    and contains(content, "[acs=0&paytimes=&tranid=")
    and contains(content, "&clientfield3=&clientfield2=&method=1&clientfield1=")
    and contains(content, "&orderid=")
    and contains(content, "&trandate=")
| fieldsAdd after_orderid = substring(content, from: indexOf(content, "&orderid=") + 9)
| fieldsAdd orderid = substring(after_orderid, from:0, to: indexOf(after_orderid, "&"))
| dedup orderid
| filter stringLength(orderid) >= 24
| fieldsAdd OrderID_noTime = substring(orderid, from:0, to:18),
            Time = substring(orderid, from:18, to:24),
            Rest = substring(orderid, from:24)
| fieldsAdd OrderIDPattern = concat(OrderID_noTime, "*", Rest)
| summarize count = count(), orderids = collectDistinct(orderid), by:{ OrderIDPattern }
| filter count > 1
| sort count desc

// ============================================================
// Verify #4 — Camunda Error And Fatal
// sample from match-examples
// Pass: >=1 row (or expected summarize/group row). Fail: 0 rows.
// ============================================================
data record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "ip-10-30-1-22.ap-northeast-1.compute.internal",
    k8s.pod.name: "camunda8-prod-zeebe-gateway-5c7d9b8f6-qwert",
    log.source: "/var/log/containers/camunda8-prod-zeebe-gateway-5c7d9b8f6-qwert_zeebe-gateway.log",
    content: "2026-10-15 09:12:34.567 [grpc-executor-2] ERROR io.camunda.zeebe.gateway - Failed to activate jobs for worker payment-worker: DEADLINE_EXCEEDED"
  )
| filter startsWith(host.name, "camunda8-prod-identity-")
    or startsWith(host.name, "camunda8-prod-zeebe-")
    or startsWith(host.name, "camunda8-prod-keycloak-")
    or startsWith(k8s.pod.name, "camunda8-prod-identity-")
    or startsWith(k8s.pod.name, "camunda8-prod-zeebe-")
    or startsWith(k8s.pod.name, "camunda8-prod-keycloak-")
| filter contains(content, "ERROR") or contains(content, "FATAL")
| fieldsAdd matched_keywords = arrayRemoveNulls(array(
    if(contains(content, "ERROR"), "ERROR"),
    if(contains(content, "FATAL"), "FATAL")
  ))
| fieldsAdd time = formatTimestamp(timestamp, format:"yyyy-MM-dd HH:mm:ss z", timezone:"Asia/Tokyo")
