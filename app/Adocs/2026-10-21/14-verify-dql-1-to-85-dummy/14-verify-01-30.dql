data record(
    k8s.pod.name: "pc-ui-5b7c9d8f6-abcde",
    k8s.workload.name: "pc-ui",
    usage: array(210.0, 250.0, 230.0),
    cpu_limit: array(1000.0, 1000.0, 1000.0)
  )
| filter k8s.workload.name == "pc-ui"
| fieldsAdd percent = round(arrayAvg(usage) / arrayAvg(cpu_limit) * 100, decimals:2)
| sort percent desc
