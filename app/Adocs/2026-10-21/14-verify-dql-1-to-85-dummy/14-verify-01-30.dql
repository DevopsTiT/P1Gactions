// ============================================================
// Verify #14 — Splunk License Usage Per Day
// sample from match-examples
// Pass: >=1 row (or expected summarize/group row). Fail: 0 rows.
// ============================================================
data record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "payment-api-prod-01",
    log.source: "/var/log/payment-api/app.log",
    content: "INFO Health check OK"
  ),
  record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "payment-api-prod-01",
    log.source: "/var/log/payment-api/app.log",
    content: "WARN Slow response 2300 ms"
  )
| fieldsAdd b = stringLength(content)
| fieldsAdd s   = coalesce(log.source, "(SQUASHED)"),
            st  = coalesce(dt.openpipeline.source, "(SQUASHED)"),
            h   = coalesce(host.name, "(SQUASHED)"),
            idx = coalesce(dt.system.bucket, "(UNKNOWN)")
| summarize b = sum(b), by:{ day = bin(timestamp, 1d), s, st, h, idx }
| fieldsAdd gb = round(toDouble(b) / 1073741824, decimals:3)
| sort day desc, b desc

