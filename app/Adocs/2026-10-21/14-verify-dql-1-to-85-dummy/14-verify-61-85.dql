// Verify #65 — Sonpovan Account Statement Tasklet Warnings
// sample from match-examples
// Pass: >=1 row (or expected summarize/group row). Fail: 0 rows.
// ============================================================
data record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "ip-10-20-32-11.ap-northeast-1.compute.internal",
    k8s.pod.name: "sonpovan-batch-7d9f8c6b5-x2k4q",
    k8s.container.name: "sonpovan-batch",
    content: "2026-10-15 09:12:34,567 WARN [step-1] j.c.s.batch.VanTRecvAccountStatementCallApiTasklet - claim 2026/004512 Message : <400 characters of response text>ERR-STMT-0042-API"
  )
| fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
| filter contains(src, "sonpov")
| filter matchesPhrase(content, "WARN")
| filter contains(content, "VanTRecvAccountStatementCallApiTasklet", caseSensitive:false)
| filter contains(content, "Message")
