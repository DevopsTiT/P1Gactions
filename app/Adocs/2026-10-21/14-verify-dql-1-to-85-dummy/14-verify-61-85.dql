// Verify #82 — Portals-Amp-Backend Errors On Save, Coverages, Quote, Bind
// sample from match-examples
// Pass: >=1 row (or expected summarize/group row). Fail: 0 rows.
// ============================================================
data record(
    timestamp: toTimestamp("2026-10-15T09:12:34.567+09:00"),
    host.name: "ip-10-20-36-14.ap-northeast-1.compute.internal",
    k8s.pod.name: "portals-amp-backend-6d7c8b9a5-h5j6k",
    k8s.container.name: "portals-amp-backend",
    log.source: "/var/log/containers/portals-amp-backend-6d7c8b9a5-h5j6k_amp_portals-amp-backend.log",
    content: "{\"level\":\"error\",\"message\":{\"url\":\"https://portals-amp-backend.example.internal/api/quote\",\"type\":\"CAUGHT_EXCEPTION_ON_BACKEND\",\"request_id\":\"req-20261015-000417\",\"target_system\":\"pc\"}}"
  )
| filter contains(k8s.container.name, "portals-amp-backend") or contains(k8s.pod.name, "portals-amp-backend") or contains(log.source, "portals-amp-backend")
| fieldsAdd raw = replaceString(replaceString(content, "\\\"", "\""), "\\", "")
| parse raw, "JSON:j"
| fieldsAdd msg_url = toString(j[message][url]), level = toString(j[level])
| filter endsWith(msg_url, "/save") or endsWith(msg_url, "/ampupdateCoverages") or endsWith(msg_url, "/quote") or endsWith(msg_url, "/bind")
| filter lower(level) == "error"
| sort timestamp desc
| fields timestamp, msg_url, level, raw

