// ===== QA: pic1 result, one row per log.source, does it icontain any pic2 path? =====
fetch logs
| filter dt.entity.host_group == "HOST_GROUP-D4032DA3E0240421"
| summarize log_count = count(), by:{log.source}
| fieldsAdd pic2 = array(
    "/opt/IBM/WebSphere/Profiles/DMGR01/logs/dmgr/SystemOut.log",
    "/opt/IBM/WebSphere/Profiles/DMGR01/logs/dmgr/SystemErr.log",
    "/opt/IBM/WebSphere/Profiles/ICM01/logs/server1/SystemOut.log",
    "/opt/IBM/WebSphere/Profiles/ICM01/logs/server1/SystemErr.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/logs/server1/SystemOut.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/logs/server1/SystemErr.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/log/",
    "/opt/IBM/WebSphere/Profiles/CPE01/FileNet/server1/p8_server_error.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/FileNet/server1/pesvr_system.log",
    "/app/ICM_CPW/log/ap/monitoringTarget.log",
    "/data/apache/inst1/logs/ApacheDaemonError.",
    "/data/apache/inst1/logs/error_ssl.",
    "/opt/jboss/standalone/log/server.log",
    "/app/ICM_CPW/log/ap/default.log",
    "/app/log/ap/default.log",
    "/app/ICM_CPW/log/sh/default.log",
    "/app/log/ap/monitoringTarget.log",
    "/IFDATA/DATA/GE/LOG/SH/default.log",
    "/IFDATA/DATA/PC/LOG/PISP2/pisp2.log",
    "/opt/HULFT/etc/trace",
    "/opt/HULFT/etc/BatchLog/HUL_JOB.LOG",
    "/opt/plat/logs/pltcomm.log",
    "/var/opt/universal/log/unv.log")
| fieldsAdd icontains_pic2 = iAny(contains(log.source, pic2[], caseSensitive: false))
| fieldsAdd matched_pic2 = arrayRemoveNulls(iCollectArray(if(contains(log.source, pic2[], caseSensitive: false), pic2[])))
| fields log.source, log_count, icontains_pic2, matched_pic2
| sort icontains_pic2 desc, log_count desc


// ===== QB: every pic2 path, FOUND or MISSING in the pic1 result =====
fetch logs
| filter dt.entity.host_group == "HOST_GROUP-D4032DA3E0240421"
| summarize log_count = count(), by:{log.source}
| fieldsAdd pic2 = array(
    "/opt/IBM/WebSphere/Profiles/DMGR01/logs/dmgr/SystemOut.log",
    "/opt/IBM/WebSphere/Profiles/DMGR01/logs/dmgr/SystemErr.log",
    "/opt/IBM/WebSphere/Profiles/ICM01/logs/server1/SystemOut.log",
    "/opt/IBM/WebSphere/Profiles/ICM01/logs/server1/SystemErr.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/logs/server1/SystemOut.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/logs/server1/SystemErr.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/log/",
    "/opt/IBM/WebSphere/Profiles/CPE01/FileNet/server1/p8_server_error.log",
    "/opt/IBM/WebSphere/Profiles/CPE01/FileNet/server1/pesvr_system.log",
    "/app/ICM_CPW/log/ap/monitoringTarget.log",
    "/data/apache/inst1/logs/ApacheDaemonError.",
    "/data/apache/inst1/logs/error_ssl.",
    "/opt/jboss/standalone/log/server.log",
    "/app/ICM_CPW/log/ap/default.log",
    "/app/log/ap/default.log",
    "/app/ICM_CPW/log/sh/default.log",
    "/app/log/ap/monitoringTarget.log",
    "/IFDATA/DATA/GE/LOG/SH/default.log",
    "/IFDATA/DATA/PC/LOG/PISP2/pisp2.log",
    "/opt/HULFT/etc/trace",
    "/opt/HULFT/etc/BatchLog/HUL_JOB.LOG",
    "/opt/plat/logs/pltcomm.log",
    "/var/opt/universal/log/unv.log")
| fieldsAdd pic2_path = arrayRemoveNulls(iCollectArray(if(contains(log.source, pic2[], caseSensitive: false), pic2[])))
| expand pic2_path
| filter isNotNull(pic2_path)
| summarize log_count = sum(log_count), sources = collectDistinct(log.source), by:{pic2_path}
| append [
    data record(pic2_path = "/opt/IBM/WebSphere/Profiles/DMGR01/logs/dmgr/SystemOut.log"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/DMGR01/logs/dmgr/SystemErr.log"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/ICM01/logs/server1/SystemOut.log"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/ICM01/logs/server1/SystemErr.log"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/CPE01/logs/server1/SystemOut.log"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/CPE01/logs/server1/SystemErr.log"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/CPE01/log/"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/CPE01/FileNet/server1/p8_server_error.log"),
      record(pic2_path = "/opt/IBM/WebSphere/Profiles/CPE01/FileNet/server1/pesvr_system.log"),
      record(pic2_path = "/app/ICM_CPW/log/ap/monitoringTarget.log"),
      record(pic2_path = "/data/apache/inst1/logs/ApacheDaemonError."),
      record(pic2_path = "/data/apache/inst1/logs/error_ssl."),
      record(pic2_path = "/opt/jboss/standalone/log/server.log"),
      record(pic2_path = "/app/ICM_CPW/log/ap/default.log"),
      record(pic2_path = "/app/log/ap/default.log"),
      record(pic2_path = "/app/ICM_CPW/log/sh/default.log"),
      record(pic2_path = "/app/log/ap/monitoringTarget.log"),
      record(pic2_path = "/IFDATA/DATA/GE/LOG/SH/default.log"),
      record(pic2_path = "/IFDATA/DATA/PC/LOG/PISP2/pisp2.log"),
      record(pic2_path = "/opt/HULFT/etc/trace"),
      record(pic2_path = "/opt/HULFT/etc/BatchLog/HUL_JOB.LOG"),
      record(pic2_path = "/opt/plat/logs/pltcomm.log"),
      record(pic2_path = "/var/opt/universal/log/unv.log")
  ]
| summarize log_count = sum(log_count), sources = arrayFlatten(collectArray(sources)), by:{pic2_path}
| fieldsAdd status = if(isNotNull(log_count) and log_count > 0, "FOUND", else: "MISSING")
| fields status, pic2_path, log_count, sources
| sort status asc, pic2_path asc


// ===== QC: loose check by file name only (works across Windows and Linux paths) =====
fetch logs
| filter dt.entity.host_group == "HOST_GROUP-D4032DA3E0240421"
| summarize log_count = count(), by:{log.source}
| fieldsAdd pic2_names = array(
    "SystemOut.log", "SystemErr.log", "p8_server_error.log", "pesvr_system.log",
    "monitoringTarget.log", "ApacheDaemonError.", "error_ssl.", "server.log",
    "default.log", "pisp2.log", "HULFT", "trace", "HUL_JOB.LOG", "pltcomm.log", "unv.log",
    "WebSphere", "FileNet", "ICM_CPW", "jboss", "IFDATA", "universal")
| fieldsAdd matched_names = arrayRemoveNulls(iCollectArray(if(contains(log.source, pic2_names[], caseSensitive: false), pic2_names[])))
| fieldsAdd loose_match = arraySize(matched_names) > 0
| fields log.source, log_count, loose_match, matched_names
| sort loose_match desc, log_count desc
