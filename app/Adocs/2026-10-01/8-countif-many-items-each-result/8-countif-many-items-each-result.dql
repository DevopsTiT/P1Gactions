// ===== A: your style, many items, ONE row: count + YES/NO + code for each item =====
fetch logs
| filter dt.entity.host_group == "HOST_GROUP-551B8509BA489285"
| summarize
    c01 = countIf(contains(log.source, "/opt/app/Calculator/Log/CalcServer.log", caseSensitive: false)),
    c02 = countIf(contains(log.source, "/app/ICM_CPW/log/ap/default.log", caseSensitive: false)),
    c03 = countIf(contains(log.source, "/app/log/ap/default.log", caseSensitive: false)),
    c04 = countIf(contains(log.source, "/app/ICM_CPW/log/sh/default.log", caseSensitive: false)),
    c05 = countIf(contains(log.source, "/app/log/ap/monitoringTarget.log", caseSensitive: false)),
    c06 = countIf(contains(log.source, "/IFDATA/DATA/GE/LOG/SH/default.log", caseSensitive: false)),
    c07 = countIf(contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/pisp2.log", caseSensitive: false)),
    c08 = countIf(contains(log.source, "/opt/HULFT/etc/trace", caseSensitive: false)),
    c09 = countIf(contains(log.source, "/opt/HULFT/etc/BatchLog/HUL_JOB.LOG", caseSensitive: false)),
    c10 = countIf(contains(log.source, "/opt/plat/logs/pltcomm.log", caseSensitive: false)),
    c11 = countIf(contains(log.source, "/var/opt/universal/log/unv.log", caseSensitive: false))
| fieldsAdd
    r01 = if(c01 > 0, "YES", else: "NO"),
    r02 = if(c02 > 0, "YES", else: "NO"),
    r03 = if(c03 > 0, "YES", else: "NO"),
    r04 = if(c04 > 0, "YES", else: "NO"),
    r05 = if(c05 > 0, "YES", else: "NO"),
    r06 = if(c06 > 0, "YES", else: "NO"),
    r07 = if(c07 > 0, "YES", else: "NO"),
    r08 = if(c08 > 0, "YES", else: "NO"),
    r09 = if(c09 > 0, "YES", else: "NO"),
    r10 = if(c10 > 0, "YES", else: "NO"),
    r11 = if(c11 > 0, "YES", else: "NO")


// ===== B: same counting, but turned into ONE ROW PER ITEM (item, log_count, result, code) =====
fetch logs
| filter dt.entity.host_group == "HOST_GROUP-551B8509BA489285"
| summarize
    c01 = countIf(contains(log.source, "/opt/app/Calculator/Log/CalcServer.log", caseSensitive: false)),
    c02 = countIf(contains(log.source, "/app/ICM_CPW/log/ap/default.log", caseSensitive: false)),
    c03 = countIf(contains(log.source, "/app/log/ap/default.log", caseSensitive: false)),
    c04 = countIf(contains(log.source, "/app/ICM_CPW/log/sh/default.log", caseSensitive: false)),
    c05 = countIf(contains(log.source, "/app/log/ap/monitoringTarget.log", caseSensitive: false)),
    c06 = countIf(contains(log.source, "/IFDATA/DATA/GE/LOG/SH/default.log", caseSensitive: false)),
    c07 = countIf(contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/pisp2.log", caseSensitive: false)),
    c08 = countIf(contains(log.source, "/opt/HULFT/etc/trace", caseSensitive: false)),
    c09 = countIf(contains(log.source, "/opt/HULFT/etc/BatchLog/HUL_JOB.LOG", caseSensitive: false)),
    c10 = countIf(contains(log.source, "/opt/plat/logs/pltcomm.log", caseSensitive: false)),
    c11 = countIf(contains(log.source, "/var/opt/universal/log/unv.log", caseSensitive: false))
| fieldsAdd items = array(
    record(item = "01 /opt/app/Calculator/Log/CalcServer.log", log_count = c01),
    record(item = "02 /app/ICM_CPW/log/ap/default.log", log_count = c02),
    record(item = "03 /app/log/ap/default.log", log_count = c03),
    record(item = "04 /app/ICM_CPW/log/sh/default.log", log_count = c04),
    record(item = "05 /app/log/ap/monitoringTarget.log", log_count = c05),
    record(item = "06 /IFDATA/DATA/GE/LOG/SH/default.log", log_count = c06),
    record(item = "07 /IFDATA/DATA/PC/LOG/PISP2/pisp2.log", log_count = c07),
    record(item = "08 /opt/HULFT/etc/trace", log_count = c08),
    record(item = "09 /opt/HULFT/etc/BatchLog/HUL_JOB.LOG", log_count = c09),
    record(item = "10 /opt/plat/logs/pltcomm.log", log_count = c10),
    record(item = "11 /var/opt/universal/log/unv.log", log_count = c11))
| fields items
| expand items
| fieldsFlatten items
| fieldsAdd result = if(items.log_count > 0, "YES", else: "NO"), code = if(items.log_count > 0, 1, else: 0)
| fields item = items.item, log_count = items.log_count, result, code
| sort item asc


// ===== C: cheaper version of B - group by log.source first (same answer, less work per item) =====
fetch logs
| filter dt.entity.host_group == "HOST_GROUP-551B8509BA489285"
| summarize n = count(), by:{log.source}
| summarize
    c01 = sum(if(contains(log.source, "/opt/app/Calculator/Log/CalcServer.log", caseSensitive: false), n, else: 0)),
    c02 = sum(if(contains(log.source, "/app/ICM_CPW/log/ap/default.log", caseSensitive: false), n, else: 0)),
    c03 = sum(if(contains(log.source, "/app/log/ap/default.log", caseSensitive: false), n, else: 0)),
    c04 = sum(if(contains(log.source, "/app/ICM_CPW/log/sh/default.log", caseSensitive: false), n, else: 0)),
    c05 = sum(if(contains(log.source, "/app/log/ap/monitoringTarget.log", caseSensitive: false), n, else: 0)),
    c06 = sum(if(contains(log.source, "/IFDATA/DATA/GE/LOG/SH/default.log", caseSensitive: false), n, else: 0)),
    c07 = sum(if(contains(log.source, "/IFDATA/DATA/PC/LOG/PISP2/pisp2.log", caseSensitive: false), n, else: 0)),
    c08 = sum(if(contains(log.source, "/opt/HULFT/etc/trace", caseSensitive: false), n, else: 0)),
    c09 = sum(if(contains(log.source, "/opt/HULFT/etc/BatchLog/HUL_JOB.LOG", caseSensitive: false), n, else: 0)),
    c10 = sum(if(contains(log.source, "/opt/plat/logs/pltcomm.log", caseSensitive: false), n, else: 0)),
    c11 = sum(if(contains(log.source, "/var/opt/universal/log/unv.log", caseSensitive: false), n, else: 0))
| fieldsAdd items = array(
    record(item = "01 /opt/app/Calculator/Log/CalcServer.log", log_count = c01),
    record(item = "02 /app/ICM_CPW/log/ap/default.log", log_count = c02),
    record(item = "03 /app/log/ap/default.log", log_count = c03),
    record(item = "04 /app/ICM_CPW/log/sh/default.log", log_count = c04),
    record(item = "05 /app/log/ap/monitoringTarget.log", log_count = c05),
    record(item = "06 /IFDATA/DATA/GE/LOG/SH/default.log", log_count = c06),
    record(item = "07 /IFDATA/DATA/PC/LOG/PISP2/pisp2.log", log_count = c07),
    record(item = "08 /opt/HULFT/etc/trace", log_count = c08),
    record(item = "09 /opt/HULFT/etc/BatchLog/HUL_JOB.LOG", log_count = c09),
    record(item = "10 /opt/plat/logs/pltcomm.log", log_count = c10),
    record(item = "11 /var/opt/universal/log/unv.log", log_count = c11))
| fields items
| expand items
| fieldsFlatten items
| fieldsAdd result = if(items.log_count > 0, "YES", else: "NO"), code = if(items.log_count > 0, 1, else: 0)
| fields item = items.item, log_count = items.log_count, result, code
| sort item asc
