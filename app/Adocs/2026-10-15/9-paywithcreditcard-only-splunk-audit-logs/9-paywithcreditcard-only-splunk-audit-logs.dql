// ===== Check A: same search over 24h, Splunk's own log files removed =====
// Expect 0 rows if portals-amp is not onboarded.
fetch logs, from:now()-24h
| filter contains(content, "payWithCreditCard_Adj")
| filter not contains(log.source, "/app/splunk/")
| summarize count = count(), by:{ k8s.namespace.name, k8s.pod.name, k8s.container.name, host.name, log.source }
| sort count desc


// ===== Check B: any portals-amp logs at all, any message, last 24h =====
fetch logs, from:now()-24h
| fieldsAdd src = lower(coalesce(k8s.pod.name, k8s.container.name, host.name, log.source))
| filter contains(src, "portals-amp")
| summarize count = count(), last_seen = max(timestamp), by:{ src }
| sort count desc
