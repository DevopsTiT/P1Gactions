// ===== Step 1: is payWithCreditCard_Adj anywhere in Dynatrace in the last hour? =====
// Splunk found 68 events in this window. If this returns 0, the logs are not in Dynatrace.
fetch logs, from:now()-1h
| filter contains(content, "payWithCreditCard_Adj")
| summarize count = count(), by:{ k8s.namespace.name, k8s.pod.name, k8s.container.name, host.name, log.source }
| sort count desc


// ===== Step 2: fixed version of the notebook query =====
// Matches the Splunk search: url contains payWithCreditCard_Adj and type is EXECUTION_COMPLETED.
fetch logs, from:now()-1h
| filter contains(content, "payWithCreditCard_Adj")
| filter contains(k8s.container.name, "portals-amp")
    or contains(k8s.pod.name, "portals-amp")
    or contains(log.source, "portals-amp")
    or contains(host.name, "portals-amp")
| fieldsAdd raw = replaceString(content, "\\\"", "\"")
| parse raw, "JSON:j"
| fieldsAdd msg_url = toString(j[message][url]),
            msg_type = toString(j[message][type]),
            request_id = toString(j[message][request_id]),
            target_system = toString(j[message][target_system])
| filter contains(msg_url, "payWithCreditCard_Adj")
| filter msg_type == "EXECUTION_COMPLETED"
| sort timestamp desc
| fields timestamp, msg_type, request_id, target_system, msg_url, raw


// ===== Step 3 (optional): the exception version you had in the notebook =====
fetch logs, from:now()-1h
| filter contains(content, "payWithCreditCard_Adj")
| filter contains(k8s.container.name, "portals-amp")
    or contains(k8s.pod.name, "portals-amp")
    or contains(log.source, "portals-amp")
    or contains(host.name, "portals-amp")
| fieldsAdd raw = replaceString(content, "\\\"", "\"")
| parse raw, "JSON:j"
| fieldsAdd msg_url = toString(j[message][url]), msg_type = toString(j[message][type])
| filter contains(msg_url, "payWithCreditCard_Adj")
| filter msg_type == "CAUGHT_EXCEPTION_ON_BACKEND"
| sort timestamp desc
| fields timestamp, msg_type, msg_url, raw
