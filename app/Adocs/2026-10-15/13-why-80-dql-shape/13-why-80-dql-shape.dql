// ===== Version 1 (current): lookup join, closest to the Splunk subsearch =====
fetch logs, from:now()-24h
| fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
| filter startsWith(src, "esbv4")
| filter contains(content, "Sending request to /esb/ebroker/kakakucomauto/online/_quote", caseSensitive:false)
| parse content, "LD ([0-9a-z]{8} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{12}):query"
| lookup [
    fetch logs, from:now()-24h
    | fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
    | filter startsWith(src, "esbv4")
    | filter contains(content, "/pc/service/edge/ebroker/quote' failed: Timeout exceeded.", caseSensitive:false)
    | parse content, "LD ([0-9a-z]{8} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{12}):query"
    | filter isNotNull(query)
    | dedup query
    | fields query
  ], sourceField:query, lookupField:query, prefix:"err."
| filter isNotNull(err.query)
| sort timestamp desc
| fields timestamp, src, query, content


// ===== Version 2 (alternative): one scan, group by request ID =====
// Reads the logs once instead of twice. Shows one row per failed request ID.
fetch logs, from:now()-24h
| fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
| filter startsWith(src, "esbv4")
| filter contains(content, "Sending request to /esb/ebroker/kakakucomauto/online/_quote", caseSensitive:false)
    or contains(content, "/pc/service/edge/ebroker/quote' failed: Timeout exceeded.", caseSensitive:false)
| parse content, "LD ([0-9a-z]{8} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{12}):query"
| filter isNotNull(query)
| fieldsAdd is_request = contains(content, "Sending request to /esb/ebroker/kakakucomauto/online/_quote", caseSensitive:false),
            is_timeout = contains(content, "Timeout exceeded.", caseSensitive:false)
| summarize request_time = min(if(is_request, timestamp)),
            timeout_time = min(if(is_timeout, timestamp)),
            requests = countIf(is_request),
            timeouts = countIf(is_timeout),
            by:{ query }
| filter requests > 0 and timeouts > 0
| sort request_time desc
| fields request_time, timeout_time, query
