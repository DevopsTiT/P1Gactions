// ===== Check 1: which namespaces does the forwarder send today (24h)? =====
fetch logs, from:now()-24h
| filter log.source == "multilogforwarder-log-handler-dynatrace"
| summarize lines = count(), last_seen = max(timestamp), by:{ k8s.namespace.name }
| sort lines desc


// ===== Check 2: are there other forwarder sources (for example a GI one)? =====
fetch logs, from:now()-24h
| filter contains(lower(log.source), "forwarder") or contains(lower(log.source), "log-handler")
| summarize lines = count(), namespaces = countDistinctExact(k8s.namespace.name), by:{ log.source }
| sort lines desc


// ===== Check 3: any namespace that looks like portals or general insurance? =====
fetch logs, from:now()-24h
| filter isNotNull(k8s.namespace.name)
| filter contains(k8s.namespace.name, "portals") or contains(k8s.namespace.name, "-gi-")
| summarize lines = count(), last_seen = max(timestamp), by:{ k8s.namespace.name, log.source }
| sort lines desc
