// Main query: same as the Splunk search
fetch logs, from:now()-24h
| filter startsWith(host.name, "camunda8-prod-identity-")
    or startsWith(host.name, "camunda8-prod-zeebe-")
    or startsWith(host.name, "camunda8-prod-keycloak-")
    or startsWith(k8s.pod.name, "camunda8-prod-identity-")
    or startsWith(k8s.pod.name, "camunda8-prod-zeebe-")
    or startsWith(k8s.pod.name, "camunda8-prod-keycloak-")
| filter contains(content, "ERROR") or contains(content, "FATAL")
| fieldsAdd matched_keywords = arrayRemoveNulls(array(
    if(contains(content, "ERROR"), "ERROR"),
    if(contains(content, "FATAL"), "FATAL")
  ))
| fieldsAdd time = formatTimestamp(timestamp, format:"yyyy-MM-dd HH:mm:ss z", timezone:"Asia/Tokyo")
| sort timestamp desc
| fields time, host.name, k8s.pod.name, matched_keywords, content

// Check 1: are camunda8 logs in Dynatrace, and under which field?
fetch logs, from:now()-24h
| filter contains(host.name, "camunda8", caseSensitive:false)
    or contains(k8s.pod.name, "camunda8", caseSensitive:false)
    or contains(k8s.namespace.name, "camunda", caseSensitive:false)
    or contains(log.source, "camunda", caseSensitive:false)
| summarize lines = count(), by:{ host.name, k8s.pod.name, k8s.namespace.name, log.source }

// Extra: count per component and keyword
fetch logs, from:now()-24h
| filter startsWith(host.name, "camunda8-prod-") or startsWith(k8s.pod.name, "camunda8-prod-")
| filter contains(content, "ERROR") or contains(content, "FATAL")
| fieldsAdd pod = coalesce(k8s.pod.name, host.name)
| fieldsAdd component = if(startsWith(pod, "camunda8-prod-zeebe-gateway-"), "zeebe-gateway",
                        else: if(startsWith(pod, "camunda8-prod-zeebe-"), "zeebe",
                        else: if(startsWith(pod, "camunda8-prod-identity-"), "identity",
                        else: if(startsWith(pod, "camunda8-prod-keycloak-"), "keycloak", else: "other"))))
| fieldsAdd keyword = if(contains(content, "FATAL"), "FATAL", else: "ERROR")
| summarize lines = count(), by:{ component, keyword }
| sort lines desc
