// src = pod name, or host name when there is no pod name.

// ===== #78 / #79 / #80 quote requests (per channel) whose ID hit the pc quote timeout =====
// Splunk subsearch -> DQL lookup.
// Inside lookup: request IDs from "Timeout exceeded" errors on the pc quote endpoint.
// Outside: "Sending request to /esb/ebroker/<channel>/online/_quote" lines with one of those IDs.
// Change the channel: inswebauto (#78), inswebbike (#79), kakakucomauto (#80).
fetch logs, from:now()-24h
| fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
| filter startsWith(src, "esbv4")
| filter contains(content, "Sending request to /esb/ebroker/inswebbike/online/_quote", caseSensitive:false)
| parse content, "LD ([0-9a-z]{8} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{12}):query"
| lookup [
    fetch logs, from:now()-24h
    | fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
    | filter startsWith(src, "esbv4")
    | filter contains(content, "Error(esb-ebroker.xml) description: HTTP POST on resource 'https://pc-inssuite-prod.op-prod-lpl.axa-direct-jp.intraxa:443/pc/service/edge/ebroker/quote' failed: Timeout exceeded.", caseSensitive:false)
    | parse content, "LD ([0-9a-z]{8} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{12}):query"
    | filter isNotNull(query)
    | dedup query
    | fields query
  ], sourceField:query, lookupField:query, prefix:"err."
| filter isNotNull(err.query)
| sort timestamp desc
| fields timestamp, src, query, content

// All three channels in one table: how many quote requests timed out per channel
fetch logs, from:now()-24h
| fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
| filter startsWith(src, "esbv4")
| filter contains(content, "Sending request to /esb/ebroker/", caseSensitive:false)
    and contains(content, "/online/_quote", caseSensitive:false)
| fieldsAdd channel = if(contains(content, "/inswebauto/"), "inswebauto",
                     else: if(contains(content, "/inswebbike/"), "inswebbike",
                     else: if(contains(content, "/kakakucomauto/"), "kakakucomauto", else: "other")))
| parse content, "LD ([0-9a-z]{8} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{12}):query"
| lookup [
    fetch logs, from:now()-24h
    | fieldsAdd src = lower(coalesce(k8s.pod.name, host.name))
    | filter startsWith(src, "esbv4")
    | filter contains(content, "/pc/service/edge/ebroker/quote' failed: Timeout exceeded.", caseSensitive:false)
    | parse content, "LD ([0-9a-z]{8} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{4} '-' [0-9a-z]{12}):query"
    | filter isNotNull(query)
    | dedup query
    | fields query
  ], sourceField:query, lookupField:query, prefix:"err."
| summarize requests = count(), timed_out = countIf(isNotNull(err.query)), by:{ channel }
| sort timed_out desc


// ===== #81 SSL certificate for ebroker expires within 30 days =====
// Splunk reads a lookup table (sslcert_lookup). Dynatrace has no such table by default.
// Option A: upload the same table to Grail as a lookup file, then:
load "/lookups/sslcert_lookup"
| filter dest == "ebroker-inssuite-prod.op-prod-lpl.axa-direct-jp.intraxa"
| fieldsAdd ssl_end = timestampFromUnixSeconds(toLong(ssl_end_time))
| filter ssl_end < now() + 30d
| fields dest, ssl_end
// Option B (recommended): a Synthetic HTTP monitor on https://ebroker-inssuite-prod.op-prod-lpl.axa-direct-jp.intraxa
// with the "SSL certificate expires in less than 30 days" check turned on. No query needed.


// ===== #82 portals-amp-backend error level on save / ampupdateCoverages / quote / bind =====
fetch logs, from:now()-1d
| filter contains(k8s.container.name, "portals-amp-backend") or contains(k8s.pod.name, "portals-amp-backend") or contains(log.source, "portals-amp-backend")
| fieldsAdd raw = replaceString(replaceString(content, "\\\"", "\""), "\\", "")
| parse raw, "JSON:j"
| fieldsAdd msg_url = toString(j[message][url]), level = toString(j[level])
| filter in(msg_url, array("save", "ampupdateCoverages", "quote", "bind"))
| filter lower(level) == "error"
| sort timestamp desc
| fields timestamp, msg_url, level, raw


// ===== #83 payWithCreditCard_Adj CAUGHT_EXCEPTION_ON_BACKEND (1 day) =====
fetch logs, from:now()-1d
| filter contains(k8s.container.name, "portals-amp-backend") or contains(k8s.pod.name, "portals-amp-backend") or contains(log.source, "portals-amp-backend")
| fieldsAdd raw = replaceString(replaceString(content, "\\\"", "\""), "\\", "")
| parse raw, "JSON:j"
| fieldsAdd msg_url = toString(j[message][url]), msg_type = toString(j[message][type])
| filter msg_url == "payWithCreditCard_Adj" and msg_type == "CAUGHT_EXCEPTION_ON_BACKEND"
| sort timestamp desc
| fields timestamp, msg_url, msg_type, raw

