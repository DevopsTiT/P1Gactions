// ===== SPL #11 and #12 (identical) =====
// error OR failed OR severe OR ( sourcetype=access_* ( 404 OR 500 OR 503 ) )
fetch logs, from:now()-1h
| filter matchesPhrase(content, "error")
    or matchesPhrase(content, "failed")
    or matchesPhrase(content, "severe")
    or (
         startsWith(log.source, "access_")
         and (matchesPhrase(content, "404") or matchesPhrase(content, "500") or matchesPhrase(content, "503"))
       )
| sort timestamp desc
| fields timestamp, host.name, log.source, loglevel, content

// Variant: if access logs carry a parsed HTTP status field
fetch logs, from:now()-1h
| filter matchesPhrase(content, "error")
    or matchesPhrase(content, "failed")
    or matchesPhrase(content, "severe")
    or (
         startsWith(log.source, "access_")
         and in(toString(http.response.status_code), array("404", "500", "503"))
       )
| sort timestamp desc
| fields timestamp, host.name, log.source, http.response.status_code, content

// Check: which field holds the Splunk "access_*" sourcetype?
fetch logs, from:now()-1h
| filter contains(log.source, "access", caseSensitive:false)
    or contains(dt.openpipeline.source, "access", caseSensitive:false)
| summarize lines = count(), by:{ log.source, dt.openpipeline.source, host.name }
| sort lines desc


// ===== SPL #13 =====
// sourcetype="pc2-ui" "https://esbv4-inssuite-prod.op-prod-lpl.axa-direct-jp.intraxa/esb/legacyclaims/services/legacydata/claims" FAIL
fetch logs, from:now()-24h
| filter contains(log.source, "pc2-ui", caseSensitive:false)
    or contains(k8s.container.name, "pc2-ui", caseSensitive:false)
    or startsWith(k8s.pod.name, "pc2-ui")
| filter contains(content, "esbv4-inssuite-prod", caseSensitive:false)
    and contains(content, "/esb/legacyclaims/services/legacydata/claims", caseSensitive:false)
| filter matchesPhrase(content, "FAIL")
| sort timestamp desc
| fields timestamp, host.name, k8s.pod.name, log.source, content

// Check: which field holds the Splunk "pc2-ui" sourcetype?
fetch logs, from:now()-24h
| filter contains(log.source, "pc2-ui", caseSensitive:false)
    or contains(k8s.container.name, "pc2-ui", caseSensitive:false)
    or contains(k8s.pod.name, "pc2-ui", caseSensitive:false)
    or contains(host.name, "pc2-ui", caseSensitive:false)
| summarize lines = count(), by:{ host.name, k8s.pod.name, k8s.container.name, log.source, dt.openpipeline.source }
| sort lines desc
