// #65 live — Sonpovan account statement WARN
fetch logs, from:now()-24h
| fieldsAdd src = lower(coalesce(k8s.pod.name, host.name, log.source))
| filter contains(src, "sonpov", caseSensitive:false)
    or contains(log.source, "sonpov", caseSensitive:false)
| filter contains(content, "WARN", caseSensitive:false)
| filter contains(content, "Van7RecvAccountStatementCallApiTasklet", caseSensitive:false)
| filter contains(content, "Message", caseSensitive:false)
| parse content, "LD (DIGIT+ '/' DIGIT+):claimNumber"
| parse content, "LD 'Message : ' LD:message"
| fieldsAdd suffix = if(stringLength(message) > 400, substring(message, from:400, to:417), "")
| sort timestamp desc
| fields timestamp, src, claimNumber, message, suffix, content

// #65 verify
fetch logs
| limit 1
| fieldsAdd dummy = "2026-10-15 09:12:34,567 WARN [step-1] Van7RecvAccountStatementCallApiTasklet - claim 2026/004512 Message : -STMT-0042-API"
| fieldsAdd pod = "sonpovan-batch-7d9f8c6b5-x2k4q"
| fields dummy, pod
| fieldsAdd src = lower(pod)
| filter contains(src, "sonpov", caseSensitive:false)
| filter contains(dummy, "WARN", caseSensitive:false)
| filter contains(dummy, "Van7RecvAccountStatementCallApiTasklet", caseSensitive:false)
| filter contains(dummy, "Message", caseSensitive:false)
| parse dummy, "LD (DIGIT+ '/' DIGIT+):claimNumber"
| parse dummy, "LD 'Message : ' LD:message"
| fieldsAdd suffix = if(stringLength(message) > 400, substring(message, from:400, to:417), "")
| fields src, claimNumber, suffix, dummy
