// #63 live — DocNotif_Adj failed
fetch logs, from:now()-24h
| fieldsAdd src = lower(coalesce(k8s.pod.name, host.name, log.source))
| filter startsWith(src, "cc-batch")
    or contains(log.source, "cc-batch", caseSensitive:false)
| filter contains(content, "Work item processed \"DocNotif_Adj\"", caseSensitive:false)
| filter contains(content, "failed=true", caseSensitive:false)
| sort timestamp desc
| fields timestamp, src, content

// #63 verify
fetch logs
| limit 1
| fieldsAdd dummy = "2026-10-15 09:12:34,567 INFO [worker-1] Work item processed \"DocNotif_Adj\" id=48213 failed=true elapsedMs=1520"
| fieldsAdd pod = "cc-batch-0"
| fields dummy, pod
| fieldsAdd src = lower(pod)
| filter startsWith(src, "cc-batch")
| filter contains(dummy, "Work item processed \"DocNotif_Adj\"", caseSensitive:false)
| filter contains(dummy, "failed=true", caseSensitive:false)
| fields src, dummy

