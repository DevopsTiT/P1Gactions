// #81 Option A — sslcert_lookup
load "/lookups/sslcert_lookup"
| filter dest == "ebroker-inssuite-prod.op-prod-lpl.axa-direct-jp.intraxa"
| fieldsAdd ssl_end = timestampFromUnixSeconds(toLong(ssl_end_time))
| fieldsAdd days_left = toLong((ssl_end - now()) / 1d)
| filter ssl_end < now() + 30d
| fields dest, ssl_end, days_left

// #82 live
fetch logs, from:now()-1d
| filter contains(k8s.container.name, "portals-amp-backend", caseSensitive:false)
    or contains(k8s.pod.name, "portals-amp-backend", caseSensitive:false)
    or contains(log.source, "portals-amp-backend", caseSensitive:false)
| parse content, "JSON:j"
| fieldsAdd msg_raw = toString(j[message])
| parse msg_raw, "JSON:msg"
| fieldsAdd msg_url = coalesce(toString(msg[url]), toString(j[message][url])),
            level = toString(j[level])
| filter endsWith(msg_url, "/save")
    or endsWith(msg_url, "/ampUpdateCoverages")
    or endsWith(msg_url, "/ampupdateCoverages")
    or endsWith(msg_url, "/quote")
    or endsWith(msg_url, "/bind")
| filter lower(level) == "error"
| sort timestamp desc
| fields timestamp, msg_url, level, content

// #82 verify
fetch logs
| limit 1
| fieldsAdd dummy = "{\"timestamp\":\"2026-10-20T08:13:02.731Z\",\"level\":\"error\",\"message\":\"{\\\"request_id\\\":\\\"r1\\\",\\\"type\\\":\\\"CAUGHT_EXCEPTION_ON_BACKEND\\\",\\\"url\\\":\\\"https://portals-api-gateway.example.internal/amp/quote\\\"}\"}"
| fields dummy
| parse dummy, "JSON:j"
| fieldsAdd msg_raw = toString(j[message])
| parse msg_raw, "JSON:msg"
| fieldsAdd msg_url = toString(msg[url]), level = toString(j[level])
| filter endsWith(msg_url, "/quote")
| filter lower(level) == "error"
| fields msg_url, level

// #83 live
fetch logs, from:now()-1d
| filter contains(k8s.container.name, "portals-amp-backend", caseSensitive:false)
    or contains(k8s.pod.name, "portals-amp-backend", caseSensitive:false)
    or contains(log.source, "portals-amp-backend", caseSensitive:false)
| parse content, "JSON:j"
| fieldsAdd msg_raw = toString(j[message])
| parse msg_raw, "JSON:msg"
| fieldsAdd msg_url = coalesce(toString(msg[url]), toString(j[message][url])),
            msg_type = coalesce(toString(msg[type]), toString(j[message][type]))
| filter contains(msg_url, "payWithCreditCard_Adj", caseSensitive:false)
    and msg_type == "CAUGHT_EXCEPTION_ON_BACKEND"
| sort timestamp desc
| fields timestamp, msg_url, msg_type, content

